---
import { Image } from "astro:assets";
import { hotels } from "../data/hotels";
import { getTranslations, type Locale } from "../i18n/utils";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);

const categories = [
  {
    id: "center-couples",
    translation: t.accommodation.categories.centerCouples,
  },
  {
    id: "city-groups",
    translation: t.accommodation.categories.cityGroups,
  },
  {
    id: "countryside",
    translation: t.accommodation.categories.countryside,
  },
];
---

<section
  id="accommodation"
  class="accommodation-section relative py-14 md:py-18"
>
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- Header -->
    <div class="mb-12 text-center md:mb-16">
      <p
        class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-[#426b7a]"
      >
        {t.accommodation.eyebrow}
      </p>

      <h2 class="mt-3 font-serif text-4xl text-[#294653] md:text-5xl">
        {t.accommodation.title}
      </h2>

      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-[#e8c95a]"></div>

      <p
        class="mx-auto mt-5 max-w-2xl font-sans text-base leading-7 text-[#426b7a]"
      >
        {t.accommodation.intro}
      </p>
    </div>

    <!-- Categories -->
    <div class="space-y-16">
      {
        categories.map((category) => {
          const categoryHotels = hotels.filter(
            (hotel) => hotel.category === category.id
          );

          return (
            <div>
              <!-- Category heading -->
              <div class="mb-8 text-center">
                <p class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-[#7e9b72]">
                  {category.translation.subtitle}
                </p>

                <h3 class="mt-2 font-serif text-3xl text-[#294653] md:text-4xl">
                  {category.translation.title}
                </h3>

                <p class="mt-2 font-sans text-sm text-[#426b7a]">
                  {category.translation.description}
                </p>
              </div>

              <!-- Hotel cards -->
              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {
                  categoryHotels.map((hotel) => (
                    <article class="group overflow-hidden rounded-[2rem] border border-white/70 bg-[#fffdf6] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                      {hotel.image && (
                        <div class="h-52 overflow-hidden">
                          <Image
                            src={hotel.image}
                            alt={hotel.name}
                            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            inferSize={true}
                            width={100}
                            height={100}
                            loading="lazy"
                          />
                        </div>
                      )}

                      <div class="p-7">
                        <h4 class="font-serif text-2xl text-[#294653] md:text-3xl">
                          {hotel.name}
                        </h4>

                        <p class="mt-4 font-sans text-sm leading-6 text-[#426b7a]">
                          {hotel.description}
                        </p>

                        {hotel.features && (
                          <div class="mt-5">
                            <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[#7e9b72]">
                              {t.accommodation.features}
                            </p>

                            <p class="mt-2 font-sans text-sm leading-6 text-[#426b7a]">
                              {hotel.features}
                            </p>
                          </div>
                        )}

                        {hotel.distance && (
                          <p class="mt-5 font-sans text-xs text-[#426b7a]">
                            📍 {hotel.distance}
                          </p>
                        )}

                        {hotel.url && hotel.url !== "---" && (
                          <a
                            href={hotel.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-6 inline-flex rounded-full bg-[#e8c95a] px-6 py-3 font-sans text-xs font-medium uppercase tracking-[0.2em] text-[#294653] shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#426b7a] hover:text-[#fffdf6] hover:shadow-md"
                          >
                            {t.accommodation.discover}
                          </a>
                        )}
                      </div>
                    </article>
                  ))
                }
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .accommodation-section {
    position: relative;

    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }

  /* Top diagonal */
  .accommodation-section::before {
    content: "";

    position: absolute;
    top: -3.5rem;
    left: 0;

    width: 100%;
    height: 3.5rem;

    background: #fff;

    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  /* Bottom diagonal */
  .accommodation-section::after {
    content: "";

    position: absolute;
    bottom: -3.5rem;
    left: 0;

    width: 100%;
    height: 3.5rem;

    background: #fff;

    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  @media (max-width: 767px) {
    .accommodation-section {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .accommodation-section::before {
      top: -2.5rem;
      height: 2.5rem;
    }

    .accommodation-section::after {
      bottom: -2.5rem;
      height: 2.5rem;
    }
  }
</style>
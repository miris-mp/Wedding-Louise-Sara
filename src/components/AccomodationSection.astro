---
import { Image } from "astro:assets";
import { hotels } from "../data/hotels";
import { getTranslations, type Locale } from "../i18n/utils";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);

const categoryLabels: Record<string, string> = {
  "center-couples": t.accommodation.categories.centerCouples.title,
  "city-groups": t.accommodation.categories.cityGroups.title,
  countryside: t.accommodation.categories.countryside.title,
  apartments: "Apartments & Holiday Homes",
  "villa-pool": "Villa with Pool",
  "rural-stay": "Rural Stay",
  "b&b": "Bed & Breakfast",
  unspecified: "Accommodation",
};
---

<section id="accommodation" class="accommodation-section relative py-14 md:py-18">
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="mb-12 text-center md:mb-16">
      <p class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-(--color-sage)">
        {t.accommodation.eyebrow}
      </p>

      <h2 class="mt-3 font-serif text-4xl text-(--color-heading) md:text-5xl">
        {t.accommodation.title}
      </h2>

      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-(--color-primary)"></div>

      <p class="mx-auto mt-5 max-w-2xl font-sans text-base leading-7 text-(--color-text)">
        {t.accommodation.intro}
      </p>
    </div>

    <!-- One grid for all accommodations -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {hotels.map((hotel) => (
        <article class="group flex h-full flex-col overflow-hidden rounded-4xl border border-(--color-border-soft) bg-(--color-surface) shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
         
{hotel.image && (
  <div class="h-52 overflow-hidden">
    <Image
      src={hotel.image}
      alt={hotel.name}
      class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
      width={800}
      height={520}
      quality={85}
      format="webp"
      loading="lazy"
    />
  </div>
)}


          <div class="flex flex-1 flex-col p-7">
            <!-- Category pill -->
            <div class="mb-3">
              <span class="inline-flex items-center rounded-full border border-(--color-border-soft) bg-(--color-surface) px-3 py-1 font-sans text-[10px] font-medium uppercase tracking-[0.16em] text-(--color-sage)">
                {categoryLabels[hotel.category] ?? "Accommodation"}
              </span>
            </div>

            <h3 class="font-serif text-2xl text-(--color-heading) md:text-3xl">
              {hotel.name}
            </h3>

            {hotel.description ? (
              <p class="mt-4 font-sans text-sm leading-6 text-(--color-text)">
                {hotel.description}
              </p>
            ) : (
              <p class="mt-4 font-sans text-sm leading-6 text-(--color-text-muted)">
                View photos, amenities, and property details on Booking.com.
              </p>
            )}

            {/* {hotel.features && (
              <div class="mt-5">
                <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-(--color-sage)">
                  {t.accommodation.features}
                </p>
                <p class="mt-2 font-sans text-sm leading-6 text-(--color-text)">
                  {hotel.features}
                </p>
              </div>
            )} */}

            {hotel.distance && (
              <p class="my-5 font-sans text-xs text-(--color-text-muted)">
                📍 {hotel.distance}
              </p>
            )}

            
{hotel.url && hotel.url !== "---" && (
  <a
    href={hotel.url}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-auto inline-flex self-end rounded-full bg-(--color-primary) px-6 py-3 font-sans text-xs font-medium uppercase tracking-[0.2em] text-(--color-surface) shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-(--color-primary-hover) hover:shadow-md"
  >
    {t.accommodation.discover}
  </a>
)}

          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .accommodation-section {
    position: relative;
  }
</style>

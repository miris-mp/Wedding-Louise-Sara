---
import { Image } from "astro:assets";
import heroImage from "@public/images/turkey.jpg";
import { getTranslations, type Locale } from "../i18n/utils";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);
---

<section
  data-parallax
  class="relative flex min-h-screen items-center justify-center overflow-hidden
         max-md:min-h-0 max-md:h-[55svh]"
>
  <!-- Mobile blurred background -->
  <Image
    src={heroImage}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 hidden h-full w-full scale-110 object-cover
           blur-xl opacity-70 max-md:block"
    widths={[640, 768, 1024]}
    sizes="100vw"
    format="webp"
    quality={85}
    loading="eager"
  />

  <!-- Main image -->
  <Image
    src={heroImage}
    alt={t.hero.imageAlt}
    class="parallax-image absolute inset-0 h-[120%] w-full object-cover
           max-md:inset-x-0 max-md:top-0 max-md:h-[95%]
           max-md:object-contain"
    widths={[640, 768, 1024, 1280, 1600, 1920]}
    sizes="100vw"
    format="webp"
    quality={100}
    loading="eager"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/25"></div>

  <!-- Content: over the image on both mobile and desktop -->
  <div
    class="relative z-10 mx-auto max-w-4xl px-6 text-center
           text-[#F7EFE5]/90 max-md:px-4"
  >
    <h1 class="font-serif text-5xl md:text-9xl max-md:text-4xl">
      {t.hero.title}
    </h1>

    <p
      class="mt-6 text-lg text-[#F7EFE5]/90 md:text-4xl max-md:mt-3 max-md:text-base"
    >
      {t.hero.subtitle}
    </p>
  </div>
</section>

<script>
  const sections = document.querySelectorAll("[data-parallax]");
  const mobileQuery = window.matchMedia("(max-width: 767px)");

  const updateParallax = () => {
    sections.forEach((section) => {
      const image = section.querySelector(
        ".parallax-image"
      ) as HTMLElement | null;

      if (!image) return;

      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      if (rect.bottom < 0 || rect.top > windowHeight) return;

      const progress = (windowHeight - rect.top) / (windowHeight + rect.height);

      if (mobileQuery.matches) {
        // Gentle movement on mobile.
        const movement = (progress - 0.5) * 350;
        image.style.transform = `translate3d(0, ${movement}px, 0)`;
      } else {
        // Original desktop parallax, unchanged.
        const offset = -180;
        const movement = (progress - 0.5) * 650 + offset;
        image.style.transform = `translate3d(0, ${movement}px, 0)`;
      }
    });
  };

  let ticking = false;

  const onScroll = () => {
    if (ticking) return;

    ticking = true;

    requestAnimationFrame(() => {
      updateParallax();
      ticking = false;
    });
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", updateParallax);
  mobileQuery.addEventListener("change", updateParallax);

  updateParallax();
</script>

---
import { getTranslations, type Locale } from "../i18n/utils";

interface Props {
  date: string;
}

const locale = (Astro.currentLocale ?? "en") as Locale;

const { date } = Astro.props;

const items = [
  { key: "days", label: "Days" },
  { key: "hours", label: "Hours" },
  { key: "minutes", label: "Minutes" },
  { key: "seconds", label: "Seconds" },
];

const t = getTranslations(locale);
---

<section
  id="countdown"
  class="countdown-section from-[#b9dce5]/30 via-[#fffdf6] to-[#fffdf6] py-10 md:py-12"
>
  <div class="mx-auto max-w-5xl px-6">
    <!-- Heading -->
    <div class="mb-7 text-center">
      <p
        class="mb-2 font-sans text-xs font-medium uppercase tracking-[0.3em] text-[#426b7a]"
      >
        {t.countdown.title}
      </p>

      <h2 class="font-serif text-3xl text-[#294653] md:text-4xl">
        {t.countdown.subtitle}
      </h2>

      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-[#e8c95a]"></div>
    </div>

    <!-- Countdown -->
    <div
      class="countdown grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4"
      data-date={date}
    >
      {
        items.map(({ key, label }) => (
          <div class="group rounded-2xl border border-[#b9dce5]/60 bg-white/70 px-4 py-5 text-center shadow-sm backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-[#7e9b72]/50 hover:shadow-md md:px-5 md:py-6">
            <span
              class={`${key} block font-serif text-4xl text-[#294653] md:text-5xl`}
            >
              00
            </span>

            <div class="mx-auto my-2.5 h-0.5 w-6 rounded-full bg-[#e8c95a] transition-all duration-300 group-hover:w-10" />

            <p class="font-sans text-[0.65rem] font-medium uppercase tracking-[0.25em] text-[#426b7a]">
              {label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const countdown = document.querySelector(".countdown");

  if (countdown) {
    const target = new Date((countdown as HTMLElement).dataset.date || "");

    const days = countdown.querySelector(".days");
    const hours = countdown.querySelector(".hours");
    const minutes = countdown.querySelector(".minutes");
    const seconds = countdown.querySelector(".seconds");

    function update() {
      const now = new Date();
      const distance = target.getTime() - now.getTime();

      if (distance <= 0) {
        [days, hours, minutes, seconds].forEach((el) => {
          if (el) el.textContent = "00";
        });

        clearInterval(timer);
        return;
      }

      const d = Math.floor(distance / (1000 * 60 * 60 * 24));

      const h = Math.floor((distance / (1000 * 60 * 60)) % 24);

      const m = Math.floor((distance / (1000 * 60)) % 60);

      const s = Math.floor((distance / 1000) % 60);

      if (days) days.textContent = String(d).padStart(2, "0");
      if (hours) hours.textContent = String(h).padStart(2, "0");
      if (minutes) minutes.textContent = String(m).padStart(2, "0");
      if (seconds) seconds.textContent = String(s).padStart(2, "0");
    }

    update();

    const timer = setInterval(update, 1000);
  }
</script>

<style>
  .countdown-section {
    position: relative;
    background: #fffdf6;

    margin-bottom: 5rem;
  }

  .countdown-section::after {
    content: "";

    position: absolute;
    bottom: -5rem;
    left: 0;

    width: 100%;
    height: 5rem;

    background: #fffdf6;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
</style>

<section class="bg-stone-50 py-24">
  <div class="mx-auto max-w-3xl px-6">
    <div class="mb-12 text-center">
      <p class="text-sm uppercase tracking-[0.35em] text-stone-500">RSVP</p>

      <h2 class="mt-4 font-serif text-5xl text-stone-800">Will You Join Us?</h2>

      <p class="mt-6 text-stone-600">Please confirm your attendance.</p>
    </div>

    <form
      id="rsvp-form"
      class="space-y-6 rounded-[2rem] bg-white p-8 shadow-xl md:p-12"
    >
      <input
        name="name"
        placeholder="Your name"
        required
        class="w-full rounded-xl border border-stone-200 px-5 py-4"
      />

      <input
        name="email"
        type="email"
        placeholder="Email"
        required
        class="w-full rounded-xl border border-stone-200 px-5 py-4"
      />

      <select
        name="attendance"
        class="w-full rounded-xl border border-stone-200 px-5 py-4"
      >
        <option value="Yes"> Joyfully accepting </option>

        <option value="No"> Sadly declining </option>
      </select>

      <input
        name="guests"
        type="number"
        min="1"
        value="1"
        class="w-full rounded-xl border border-stone-200 px-5 py-4"
      />

      <textarea
        name="dietary"
        placeholder="Dietary requirements"
        rows="3"
        class="w-full rounded-xl border border-stone-200 px-5 py-4"></textarea>

      <textarea
        name="message"
        placeholder="A message for the couple"
        rows="3"
        class="w-full rounded-xl border border-stone-200 px-5 py-4"></textarea>

      <button
        class="w-full rounded-full bg-stone-800 py-4 text-sm uppercase tracking-[0.25em] text-white transition hover:bg-stone-700"
      >
        Confirm Attendance
      </button>

      <p
        id="success"
        class="hidden rounded-2xl bg-stone-100 p-8 text-center font-serif text-2xl text-stone-700"
      >
        Thank you! ❤️
        <br />
        <span class="mt-3 block text-base font-sans text-stone-500">
          Your RSVP has been received. We can't wait to celebrate with you!
        </span>
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector("#rsvp-form") as HTMLFormElement;
  const button = form?.querySelector("button") as HTMLButtonElement;
  const success = document.querySelector("#success");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!button) return;

    button.disabled = true;
    button.textContent = "Sending...";

    const formData = new FormData(form);

    const data = Object.fromEntries(formData);

    try {
      const response = await fetch(
        "https://script.google.com/macros/s/AKfycbzkE73AhqE_8CdoRSnz-ZsiPo_iDdYEFB10ubGNg13qTbszmu4t9Pwda_NltlOL6hkA/exec",
        {
          method: "POST",
          body: JSON.stringify(data),
        }
      );

      if (!response.ok) {
        throw new Error("Something went wrong");
      }

      form.reset();

      form
        .querySelectorAll("input, textarea, select, button")
        .forEach((element) => {
          (element as HTMLElement).style.display = "none";
        });

      success?.classList.remove("hidden");

      success?.classList.add("animate-fade-in");
    } catch (error) {
      console.error(error);

      button.disabled = false;
      button.textContent = "Confirm Attendance";

      alert("Sorry, something went wrong. Please try again.");
    }
  });
</script>

---
import { getTranslations, type Locale } from "../i18n/utils";
import { Image } from "astro:assets";

interface Props {
  logoPath?: string;
}

const { logoPath = "/images/logoPizzaSimple.png" } = Astro.props;

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);

const prefix = locale === "en" ? "" : `/${locale}`;

const navItems = [
  { name: t.nav.rsvp, href: `${prefix}/rsvp` },
  { name: t.nav.timeline, href: `${prefix}/timeline` },
  { name: t.nav.explorePuglia, href: `${prefix}/goto` },
  { name: t.nav.accommodation, href: `${prefix}/accommodation` },
  { name: t.nav.ourStory, href: `${prefix}/our-story` },
  { name: t.nav.honeymoon, href: `${prefix}/honeymoon` },
  { name: t.nav.faq, href: `${prefix}/faq` },
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display:ital@0;1&display=swap"
  rel="stylesheet"
/>

<header class="wedding-header">
  <div class="header-container">
    <!-- Logo -->
    <a href={locale === "en" ? "/" : "/it/"} class="logo-link">
      <Image
        src={logoPath}
        width={100}
        height={100}
        alt="Louise & Sara Wedding Logo"
        class="logo-img"
      />
    </a>

    <!-- Navigation -->
    <nav class="nav-menu" aria-label="Main navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile Menu -->
    <button class="mobile-toggle" aria-label="Toggle Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  :root {
    --font-display: "DM Serif Display", Georgia, serif;
    --font-sans: "DM Sans", sans-serif;

    /* =========================
       PALETTE
       ========================= */

    --color-rose: #cf8981;
    --color-ivory: #f2e6da;
    --color-peach: #dfa688;
    --color-sage: #7e9b86;
    --color-forest: #2f4a3f;

    /* =========================
       SEMANTIC
       ========================= */

    --color-page-bg: var(--color-ivory);
    --color-surface: #fffdf9;
    --color-surface-soft: #f8eee8;

    --color-heading: var(--color-forest);
    --color-text: #496158;
    --color-text-muted: #6f8078;

    --color-primary: var(--color-rose);
    --color-primary-hover: #bd746c;

    --color-secondary: var(--color-sage);
    --color-accent: var(--color-peach);

    --color-border: rgba(47, 74, 63, 0.14);
    --color-border-soft: rgba(126, 155, 134, 0.25);

    /* =========================
       SPECIAL WEDDING COLORS
       ========================= */

    --color-floral: var(--color-rose);
    --color-nature: var(--color-sage);
    --color-dark: var(--color-forest);

    --color-highlight: rgba(207, 137, 129, 0.15);
    --color-sage-soft: rgba(126, 155, 134, 0.14);
    --color-peach-soft: rgba(223, 166, 136, 0.18);

    /* =========================
       GRADIENTS
       ========================= */

    --gradient-wedding: linear-gradient(
      135deg,
      var(--color-rose),
      var(--color-peach)
    );

    --gradient-soft: linear-gradient(
      135deg,
      var(--color-ivory),
      var(--color-sage-soft)
    );
  }

  /* =========================
     HEADER
     ========================= */

  .wedding-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;

    background: linear-gradient(
      180deg,
      rgba(242, 230, 218, 0.96) 0%,
      rgba(255, 253, 249, 0.94) 100%
    );

    border-bottom: 1px solid var(--color-border);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;

    padding: 0.7rem 2rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  /* =========================
     LOGO
     ========================= */

  .logo-link {
    display: inline-block;

    transition:
      transform 0.35s ease,
      rotate 0.35s ease;
  }

  .logo-link:hover {
    transform: scale(1.04) rotate(-1deg);
  }

  .logo-img {
    display: block;
    height: 120px;
    width: auto;
    object-fit: contain;
  }

  /* =========================
     NAVIGATION
     ========================= */

  .nav-menu ul {
    list-style: none;

    padding: 0;
    margin: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 0.35rem;
  }

  .nav-link {
    display: block;

    padding: 0.45rem 0.8rem;

    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;

    color: var(--color-heading);
    text-decoration: none;

    border-radius: 999px;

    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .nav-link:hover {
    color: var(--color-heading);

    background: var(--color-sage-soft);

    transform: translateY(-1px);
  }

  /* =========================
     RSVP
     ========================= */

  .nav-menu li:nth-child(1) .nav-link {
    color: var(--color-surface);

    background: var(--color-primary);

    padding-left: 1.05rem;
    padding-right: 1.05rem;

    box-shadow: 0 3px 10px rgba(47, 74, 63, 0.12);
  }

  .nav-menu li:nth-child(1) .nav-link:hover {
    color: var(--color-surface);

    background: var(--color-primary-hover);

    transform: translateY(-2px);

    box-shadow: 0 5px 14px rgba(47, 74, 63, 0.18);
  }

  /* =========================
     MOBILE MENU
     ========================= */

  .mobile-toggle {
    display: none;

    background: none;
    border: none;

    cursor: pointer;

    flex-direction: column;
    gap: 5px;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;

    background-color: var(--color-dark);

    border-radius: 2px;
  }

  /* =========================
     DESKTOP
     ========================= */

  @media (min-width: 768px) {
    .header-container {
      flex-direction: row;
      justify-content: space-between;

      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .logo-img {
      height: 90px;
    }

    .nav-menu ul {
      gap: 0.2rem;
    }
  }

  /* =========================
     SMALL SCREENS
     ========================= */

  @media (max-width: 600px) {
    .header-container {
      padding: 0.6rem 1rem;
    }

    .logo-img {
      height: 90px;
    }

    .nav-menu ul {
      gap: 0.1rem;
      flex-wrap: wrap;
    }

    .nav-link {
      font-size: 0.78rem;
      padding: 0.35rem 0.55rem;
    }
  }
</style>

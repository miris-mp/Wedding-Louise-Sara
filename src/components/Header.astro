---
import { Image } from "astro:assets";

// src/components/Header.astro
interface Props {
  logoPath?: string;
}

const { logoPath = "/images/logo.svg" } = Astro.props;

// Navigation links for the wedding website
const navItems = [
  { name: "Our Story", href: "#story" },
  { name: "Location", href: "#location" },
  { name: "Schedule", href: "#schedule" },
  { name: "Honeymoon", href: "#honeymoon" },
  { name: "RSVP", href: "#rsvp" },
];
---

<!-- Import Playfair Display from Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Montserrat:wght@300;400;500&display=swap"
  rel="stylesheet"
/>

<header class="wedding-header">
  <div class="header-container">
    <!-- Brand / Logo Section -->
    <a href="/" class="logo-link">
      <Image
        src={logoPath}
        width={100}
        height={100}
        alt="Louise & Sara Wedding Logo"
        class="logo-img"
      />
    </a>

    <!-- Navigation Menu -->
    <nav class="nav-menu">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile Menu Button (Optional functionality can be added via JS) -->
    <button class="mobile-toggle" aria-label="Toggle Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  :root {
    --font-serif: "Playfair Display", Georgia, serif;
    --font-sans: "Montserrat", sans-serif;
    --color-navy: #1d3557;
    --color-gold: #c5a059;
    --color-bg: #fdfbf7;
  }

  .wedding-header {
    background-color: var(--color-bg);
    border-bottom: 1px solid rgba(197, 160, 89, 0.2);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(8px);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* Logo styling */
  .logo-link {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .logo-link:hover {
    transform: scale(1.02);
  }

  .logo-img {
    height: 140px; /* Adjust depending on logo size preference */
    width: auto;
    object-fit: contain;
  }

  /* Navigation styling */
  .nav-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 2.5rem;
  }

  .nav-link {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-navy);
    text-decoration: none;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 4px;
    transition: color 0.3s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    width: 0;
    height: 1px;
    bottom: 0;
    left: 50%;
    background-color: var(--color-gold);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .nav-link:hover {
    color: var(--color-gold);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Mobile menu toggle */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;
    background-color: var(--color-navy);
  }

  /* Responsive Adjustments */
  @media (min-width: 768px) {
    .header-container {
      flex-direction: row;
      justify-content: space-between;
    }

    .logo-img {
      height: 110px;
    }
  }

  @media (max-width: 600px) {
    .nav-menu ul {
      gap: 1.2rem;
    }

    .nav-link {
      font-size: 0.95rem;
    }

    .logo-img {
      height: 110px;
    }
  }
</style>

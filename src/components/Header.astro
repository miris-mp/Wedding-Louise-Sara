---
import { Image } from "astro:assets";

interface Props {
  logoPath?: string;
}

const { logoPath = "/images/logo.svg" } = Astro.props;

const navItems = [
  { name: "Location", href: "#location" },
  { name: "RSVP", href: "#rsvp" },
  { name: "Accomodation", href: "#accomodation" },
  { name: "Explore Puglia", href: "#goto" },
  { name: "Our Story", href: "#story" },
  { name: "Honeymoon", href: "#honeymoon" },
  { name: "FAQ", href: "#faq" },
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display:ital@0;1&display=swap"
  rel="stylesheet"
/>

<header class="wedding-header">
  <div class="header-container">
    <!-- Logo -->
    <a href="/" class="logo-link">
      <Image
        src={logoPath}
        width={100}
        height={100}
        alt="Louise & Sara Wedding Logo"
        class="logo-img"
      />
    </a>

    <!-- Navigation -->
    <nav class="nav-menu" aria-label="Main navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile Menu -->
    <button class="mobile-toggle" aria-label="Toggle Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  :root {
    --font-display: "DM Serif Display", Georgia, serif;
    --font-sans: "DM Sans", sans-serif;

    /* Mediterranean garden palette */
    --color-sky: #b9dce5;
    --color-blue: #426b7a;
    --color-deep-blue: #294653;

    --color-sage: #7e9b72;
    --color-yellow: #e8c95a;

    --color-cream: #fffdf6;
  }

  .wedding-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;

    background: linear-gradient(
      180deg,
      rgba(185, 220, 229, 0.92) 0%,
      rgba(255, 253, 246, 0.92) 100%
    );

    border-bottom: 1px solid rgba(66, 107, 122, 0.15);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;

    padding: 0.7rem 2rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  /* Logo */

  .logo-link {
    display: inline-block;

    transition:
      transform 0.35s ease,
      rotate 0.35s ease;
  }

  .logo-link:hover {
    transform: scale(1.04) rotate(-1deg);
  }

  .logo-img {
    display: block;
    height: 120px;
    width: auto;
    object-fit: contain;
  }

  /* Navigation */

  .nav-menu ul {
    list-style: none;

    padding: 0;
    margin: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 0.35rem;
  }

  .nav-link {
    display: block;

    padding: 0.45rem 0.8rem;

    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;

    color: var(--color-deep-blue);
    text-decoration: none;

    border-radius: 999px;

    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .nav-link:hover {
    color: var(--color-blue);

    background: rgba(126, 155, 114, 0.14);

    transform: translateY(-1px);
  }

  /* RSVP */

  .nav-menu li:nth-child(2) .nav-link {
    color: var(--color-deep-blue);

    background: var(--color-yellow);

    padding-left: 1.05rem;
    padding-right: 1.05rem;

    box-shadow: 0 3px 10px rgba(66, 107, 122, 0.12);
  }

  .nav-menu li:nth-child(2) .nav-link:hover {
    color: var(--color-cream);

    background: var(--color-sage);

    transform: translateY(-2px);

    box-shadow: 0 5px 14px rgba(66, 107, 122, 0.18);
  }

  /* Mobile */

  .mobile-toggle {
    display: none;

    background: none;
    border: none;

    cursor: pointer;

    flex-direction: column;
    gap: 5px;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;

    background-color: var(--color-deep-blue);

    border-radius: 2px;
  }

  /* Desktop */

  @media (min-width: 768px) {
    .header-container {
      flex-direction: row;
      justify-content: space-between;

      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .logo-img {
      height: 90px;
    }

    .nav-menu ul {
      gap: 0.2rem;
    }
  }

  /* Small screens */

  @media (max-width: 600px) {
    .header-container {
      padding: 0.6rem 1rem;
    }

    .logo-img {
      height: 90px;
    }

    .nav-menu ul {
      gap: 0.1rem;
      flex-wrap: wrap;
    }

    .nav-link {
      font-size: 0.78rem;
      padding: 0.35rem 0.55rem;
    }
  }
</style>

---
import { getTranslations, type Locale } from "../i18n/utils";
import { Image } from "astro:assets";

interface Props {
  logoPath?: string;
}

const { logoPath = "/images/logo.png" } = Astro.props;

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);

const prefix = locale === "en" ? "" : `/${locale}`;

const normalize = (p: string) => p.replace(/\/+$/, "") || "/";

const currentPath = normalize(Astro.url.pathname);

const navItems = [
  { name: t.nav.rsvp, href: `${prefix}/rsvp` },
  { name: t.nav.timeline, href: `${prefix}/timeline` },
  { name: t.nav.explorePuglia, href: `${prefix}/goto` },
  { name: t.nav.accommodation, href: `${prefix}/accommodation` },
  { name: t.nav.ourStory, href: `${prefix}/our-story` },
  { name: t.nav.honeymoon, href: `${prefix}/honeymoon` },
  { name: t.nav.faq, href: `${prefix}/faq` },
];

// Equivalent URLs for the current page in both languages.
const englishPath = normalize(currentPath.replace(/^\/it(?=\/|$)/, ""));

const italianPath = englishPath === "/" ? "/it/" : `/it${englishPath}`;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display:ital@0;1&display=swap"
  rel="stylesheet"
/>

<header class="wedding-header" id="wedding-header">
  <div class="header-container">
    <!-- Logo -->
    <a
      href={locale === "en" ? "/" : "/it/"}
      class="logo-link"
      aria-label="Louise and Sara — home"
    >
      <Image
        src={logoPath}
        width={100}
        height={100}
        alt="Louise & Sara Wedding Logo"
        class="logo-img"
      />
    </a>

    <!-- Desktop navigation; also used in the mobile dropdown -->
    <nav class="nav-menu" id="main-navigation" aria-label="Main navigation">
      <ul>
        {
          navItems.map((item) => {
            const isActive = currentPath === normalize(item.href);

            return (
              <li>
                <a
                  href={item.href}
                  class:list={["nav-link", { active: isActive }]}
                  aria-current={isActive ? "page" : undefined}
                >
                  {item.name}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Language switcher -->
    <nav class="language-switcher" aria-label="Choose language">
      <a
        href={englishPath}
        class:list={["language-option", { "language-active": locale === "en" }]}
        lang="en"
        aria-current={locale === "en" ? "page" : undefined}
        aria-label="English"
      >
        🇬🇧
      </a>

      <span class="language-separator" aria-hidden="true">|</span>

      <a
        href={italianPath}
        class:list={["language-option", { "language-active": locale === "it" }]}
        lang="it"
        aria-current={locale === "it" ? "page" : undefined}
        aria-label="Italiano"
      >
        🇮🇹
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      class="mobile-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector("#wedding-header");

  if (header && !header.hasAttribute("data-menu-ready")) {
    header.setAttribute("data-menu-ready", "true");

    const toggle = header.querySelector(".mobile-toggle");
    const links = header.querySelectorAll(".nav-link, .language-option");

    const setMenuOpen = (open: boolean) => {
      header.classList.toggle("menu-open", open);
      toggle?.setAttribute("aria-expanded", String(open));
      toggle?.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu"
      );
    };

    toggle?.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isOpen);
    });

    links.forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuOpen(false);
      }
    });

    // Close the dropdown if the screen changes to desktop size.
    window
      .matchMedia("(min-width: 768px)")
      .addEventListener("change", (event) => {
        if (event.matches) setMenuOpen(false);
      });
  }
</script>

<style>
  :root {
    --font-display: "DM Serif Display", Georgia, serif;
    --font-sans: "DM Sans", sans-serif;

    /* =========================
       PALETTE
       ========================= */

    --color-rose: #cf8981;
    --color-ivory: #f2e6da;
    --color-peach: #dfa688;
    --color-sage: #7e9b86;
    --color-forest: #2f4a3f;

    /* =========================
       SEMANTIC
       ========================= */

    --color-page-bg: var(--color-ivory);
    --color-surface: #fffdf9;
    --color-surface-soft: #f8eee8;

    --color-heading: var(--color-forest);
    --color-text: #496158;
    --color-text-muted: #6f8078;

    --color-primary: var(--color-rose);
    --color-primary-hover: #bd746c;

    --color-secondary: var(--color-sage);
    --color-accent: var(--color-peach);

    --color-border: rgba(47, 74, 63, 0.14);
    --color-border-soft: rgba(126, 155, 134, 0.25);

    /* =========================
       SPECIAL WEDDING COLORS
       ========================= */

    --color-floral: var(--color-rose);
    --color-nature: var(--color-sage);
    --color-dark: var(--color-forest);

    --color-highlight: rgba(207, 137, 129, 0.15);
    --color-sage-soft: rgba(149, 155, 126, 0.14);
    --color-peach-soft: rgba(223, 166, 136, 0.18);

    /* =========================
       GRADIENTS
       ========================= */

    --gradient-wedding: linear-gradient(
      135deg,
      var(--color-rose),
      var(--color-peach)
    );

    --gradient-soft: linear-gradient(
      135deg,
      var(--color-ivory),
      var(--color-sage-soft)
    );
  }

  /* =========================
     HEADER
     ========================= */

  .wedding-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;

    background: linear-gradient(
      180deg,
      rgba(242, 230, 218, 0.96) 0%,
      rgba(255, 253, 249, 0.94) 100%
    );

    border-bottom: 1px solid var(--color-border);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;

    padding: 0.7rem 2rem;

    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 0.4rem;
  }

  /* =========================
     LOGO
     ========================= */

  .logo-link {
    display: inline-block;

    transition:
      transform 0.35s ease,
      rotate 0.35s ease;
  }

  .logo-link:hover {
    transform: scale(1.04) rotate(-1deg);
  }

  .logo-img {
    display: block;
    height: 120px;
    width: auto;
    object-fit: contain;
  }

  /* =========================
     NAVIGATION
     ========================= */

  .nav-menu ul {
    list-style: none;

    padding: 0;
    margin: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 0.35rem;
  }

  .nav-link {
    display: block;

    padding: 0.45rem 0.8rem;

    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;

    color: var(--color-heading);
    text-decoration: none;

    border-radius: 999px;

    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-surface);

    background: var(--color-primary);
    transform: translateY(-1px);

    box-shadow: 0 3px 10px rgba(47, 74, 63, 0.12);
  }
  /* =========================
     RSVP
     ========================= */

  .nav-menu li:nth-child(1) .nav-link:hover {
    color: var(--color-surface);

    background: var(--color-primary-hover);

    transform: translateY(-2px);

    box-shadow: 0 5px 14px rgba(47, 74, 63, 0.18);
  }

  /* =========================
   LANGUAGE SWITCHER
   ========================= */

  .language-switcher {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;

    padding: 0.3rem;
  }

  .language-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0.4rem 0.65rem;

    border-radius: 999px;

    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.04em;

    color: var(--color-heading);
    text-decoration: none;

    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .language-option:hover,
  .language-option.language-active {
    background: var(--color-sage-soft);
  }

  .language-option:focus-visible {
    outline: 2px solid var(--color-primary-hover);
    outline-offset: 3px;
  }

  .language-separator {
    color: var(--color-border);
    font-size: 0.75rem;
  }

  @media (max-width: 767px) {
    .language-switcher {
      margin-top: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-option {
      transition: none;
    }
  }

  /* =========================
     MOBILE MENU
     ========================= */

  .mobile-toggle {
    display: none;

    background: none;
    border: none;

    cursor: pointer;

    flex-direction: column;
    gap: 5px;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;

    background-color: var(--color-dark);

    border-radius: 2px;
  }

  /* =========================
     DESKTOP
     ========================= */

  /* QUICK FIX: MOBILE HAMBURGER */
  @media screen and (max-width: 767px) {
    .wedding-header .header-container {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0;
      padding: 0.4rem 1rem;
    }

    .wedding-header .mobile-toggle {
      display: flex !important;
      grid-column: 2;
      grid-row: 1;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 46px;
      height: 46px;
      padding: 10px;
      background: var(--color-surface);
      border: 1px solid var(--color-border-soft);
      border-radius: 50%;
      cursor: pointer;
      z-index: 10;
    }

    .wedding-header .mobile-toggle span {
      display: block;
      width: 21px;
      height: 2px;
      background: var(--color-forest);
      border-radius: 2px;
    }

    .wedding-header .nav-menu,
    .wedding-header .language-switcher {
      display: none;
    }

    .wedding-header.menu-open .nav-menu {
      display: block;
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      margin-top: 0.65rem;
      padding: 0.65rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border-soft);
      border-radius: 18px;
    }

    .wedding-header.menu-open .language-switcher {
      display: inline-flex;
      grid-column: 1 / -1;
      grid-row: 3;
      justify-self: start;
      align-items: center;
      gap: 0.1rem;
      margin: 0.35rem 0 0;
      padding: 0.1rem;
      border: none;
      background: transparent;
    }

    .wedding-header .language-option {
      min-width: 34px;
      min-height: 34px;
      padding: 0.25rem;
      font-size: 0.9rem;
    }

    .wedding-header .language-separator {
      font-size: 0.65rem;
    }

    .wedding-header .nav-menu ul {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .wedding-header .nav-menu li,
    .wedding-header .nav-link {
      width: 100%;
    }

    .wedding-header .nav-link {
      min-height: 44px;
      padding: 0.7rem 0.9rem;
    }

    .wedding-header.menu-open .mobile-toggle span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .wedding-header.menu-open .mobile-toggle span:nth-child(2) {
      opacity: 0;
    }

    .wedding-header.menu-open .mobile-toggle span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  @media screen and (min-width: 768px) {
    .wedding-header .mobile-toggle {
      display: none !important;
    }

    .wedding-header .nav-menu {
      display: block;
    }

    .wedding-header .language-switcher {
      display: inline-flex;
    }
  }
</style>

---
import { getTranslations, type Locale } from "../i18n/utils";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);
const rsvp = t.rsvp;
---

<section id="rsvp" class="rsvp-section relative py-16 md:py-24">
  <div class="relative z-10 mx-auto max-w-3xl px-6">
    <!-- Heading -->
    <div class="mb-10 text-center md:mb-12">
      <p class="rsvp-eyebrow">
        {rsvp.eyebrow}
      </p>

      <h2 class="rsvp-heading">
        {rsvp.title}
      </h2>

      <div class="line-divider"></div>

      <p class="rsvp-intro">
        {rsvp.intro}
      </p>
    </div>

    <!-- RSVP Form -->
    <form
      id="rsvp-form"
      data-sending={rsvp.sending}
      data-submit-label={rsvp.submit}
      class="rsvp-form"
    >
      <!-- Decorative corners -->
      <div class="rsvp-decoration rsvp-decoration-top" aria-hidden="true"></div>
      <div class="rsvp-decoration rsvp-decoration-bottom" aria-hidden="true">
      </div>

      <div class="rsvp-form-content">
        <!-- Main guest name -->
        <div>
          <label for="rsvp-name" class="rsvp-label">
            {rsvp.name}
          </label>

          <input
            id="rsvp-name"
            name="name"
            type="text"
            placeholder={rsvp.namePlaceholder}
            required
            autocomplete="name"
            class="rsvp-input"
          />
        </div>

        <!-- Main guest dietary requirements -->
        <div id="dietary-field">
          <label for="rsvp-dietary" class="rsvp-label">
            {rsvp.dietary}
          </label>

          <textarea
            id="rsvp-dietary"
            name="dietary"
            placeholder={rsvp.dietaryPlaceholder}
            rows="3"
            class="rsvp-input rsvp-textarea"></textarea>
        </div>

        <!-- Email -->
        <div>
          <label for="rsvp-email" class="rsvp-label">
            {rsvp.email}
          </label>

          <input
            id="rsvp-email"
            name="email"
            type="email"
            placeholder={rsvp.emailPlaceholder}
            required
            autocomplete="email"
            class="rsvp-input"
          />
        </div>

        <!-- Attendance -->
        <fieldset>
          <legend class="rsvp-label rsvp-legend">
            {rsvp.attendance}
          </legend>

          <div class="grid gap-3 sm:grid-cols-2">
            <!-- Accept -->
            <label class="rsvp-choice">
              <input
                type="radio"
                name="attendance"
                value="Yes"
                required
                class="peer sr-only"
              />

              <div class="rsvp-choice-card">
                <div class="rsvp-choice-icon" aria-hidden="true">♡</div>

                <p class="rsvp-choice-title">
                  {rsvp.accept}
                </p>

                <p class="rsvp-choice-description">
                  {rsvp.acceptDescription}
                </p>
              </div>
            </label>

            <!-- Decline -->
            <label class="rsvp-choice">
              <input
                type="radio"
                name="attendance"
                value="No"
                required
                class="peer sr-only"
              />

              <div class="rsvp-choice-card">
                <div class="rsvp-choice-icon" aria-hidden="true">♧</div>

                <p class="rsvp-choice-title">
                  {rsvp.decline}
                </p>

                <p class="rsvp-choice-description">
                  {rsvp.declineDescription}
                </p>
              </div>
            </label>
          </div>
        </fieldset>

        <!-- Number of guests -->
        <div id="guests-field">
          <label for="rsvp-guests" class="rsvp-label">
            {rsvp.guests}
          </label>

          <select id="rsvp-guests" name="guests" required class="rsvp-select">
            <option value="1">1</option>
            <option value="2">2</option>
          </select>
        </div>

        <!-- Second guest -->
        <div id="guest-2-field" class="rsvp-guest-two" hidden>
          <label for="rsvp-guest-2-name" class="rsvp-label">
            {rsvp.secondGuestName}
          </label>

          <input
            id="rsvp-guest-2-name"
            name="guest_2_name"
            type="text"
            placeholder={rsvp.secondGuestNamePlaceholder}
            autocomplete="off"
            class="rsvp-input"
          />

          <label
            for="rsvp-guest-2-dietary"
            class="rsvp-label rsvp-second-label"
          >
            {rsvp.secondGuestDietary}
          </label>

          <textarea
            id="rsvp-guest-2-dietary"
            name="guest_2_dietary"
            placeholder={rsvp.dietaryPlaceholder}
            rows="3"
            class="rsvp-input rsvp-textarea"></textarea>
        </div>

        <!-- Playlist -->

        <!-- Song request -->
        <div id="playlist-field">
          <label for="rsvp-song" class="rsvp-label">
            {rsvp.song}
          </label>

          <input
            id="rsvp-song"
            name="song"
            type="text"
            placeholder="e.g. September — Earth, Wind & Fire"
            autocomplete="off"
            maxlength="200"
            class="rsvp-input"
          />

          <p class="rsvp-hint">
            Got a song that will get everyone dancing? Tell us the title and
            artist!
          </p>
        </div>

        <!-- Message to the couple -->
        <div>
          <label for="rsvp-message" class="rsvp-label">
            {rsvp.message}
          </label>

          <textarea
            id="rsvp-message"
            name="message"
            placeholder={rsvp.messagePlaceholder}
            rows="3"
            class="rsvp-input rsvp-textarea"></textarea>
        </div>

        <!-- Submit -->
        <button id="rsvp-submit" type="submit" class="rsvp-submit">
          {rsvp.submit}
        </button>

        <!-- Success -->
        <div id="success" class="rsvp-success" hidden>
          <!-- Accepted -->
          <div id="success-yes" hidden>
            <p class="rsvp-success-title">
              {rsvp.successYesTitle}
            </p>

            <p class="rsvp-success-message">
              {rsvp.successYesMessage}
            </p>
          </div>

          <!-- Declined -->
          <div id="success-no" hidden>
            <p class="rsvp-success-title">
              {rsvp.successNoTitle}
            </p>

            <p class="rsvp-success-message">
              {rsvp.successNoMessage}
            </p>
          </div>
        </div>

        <!-- Error -->
        <div id="error" class="rsvp-error" role="alert" hidden>
          {rsvp.error}
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector("#rsvp-form") as HTMLFormElement | null;

  const button = document.querySelector(
    "#rsvp-submit"
  ) as HTMLButtonElement | null;

  const success = document.querySelector("#success");
  const successYes = document.querySelector("#success-yes");
  const successNo = document.querySelector("#success-no");
  const errorMessage = document.querySelector("#error");

  const guestsField = document.querySelector("#guests-field");
  const dietaryField = document.querySelector("#dietary-field");
  const playlistField = document.querySelector("#playlist-field");

  const guestsInput = document.querySelector(
    "#rsvp-guests"
  ) as HTMLSelectElement | null;

  const guest2Field = document.querySelector(
    "#guest-2-field"
  ) as HTMLDivElement | null;

  const guest2Name = document.querySelector(
    "#rsvp-guest-2-name"
  ) as HTMLInputElement | null;

  const GOOGLE_SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbwLPHMzx-2JmQCMVgKCjA4yXK8tPrYBfhbA7azzbLULoRvjhwTXTKfK94UYar2X-PE/exec";

  const sendingText = form?.dataset.sending ?? "Sending...";
  const submitText = form?.dataset.submitLabel ?? "Send My RSVP";

  /*
   * Show or hide fields depending on attendance.
   */
  form
    ?.querySelectorAll<HTMLInputElement>('input[name="attendance"]')
    .forEach((radio) => {
      radio.addEventListener("change", () => {
        const selected = form.querySelector<HTMLInputElement>(
          'input[name="attendance"]:checked'
        )?.value;

        if (selected === "No") {
          guestsField?.setAttribute("hidden", "");
          dietaryField?.setAttribute("hidden", "");
          guest2Field?.setAttribute("hidden", "");
          playlistField?.setAttribute("hidden", "");

          if (guestsInput) {
            guestsInput.required = false;
            guestsInput.value = "1";
          }

          if (guest2Name) {
            guest2Name.required = false;
            guest2Name.value = "";
          }
        } else {
          guestsField?.removeAttribute("hidden");
          dietaryField?.removeAttribute("hidden");
          playlistField?.removeAttribute("hidden");

          if (guestsInput) {
            guestsInput.required = true;
          }

          updateGuestFields();
        }
      });
    });

  /*
   * Show the second guest fields when two guests are selected.
   */
  function updateGuestFields() {
    if (!guestsInput) return;

    const numberOfGuests = Number(guestsInput.value);

    if (numberOfGuests === 2) {
      guest2Field?.removeAttribute("hidden");

      if (guest2Name) {
        guest2Name.required = true;
      }
    } else {
      guest2Field?.setAttribute("hidden", "");

      if (guest2Name) {
        guest2Name.required = false;
        guest2Name.value = "";
      }
    }
  }

  guestsInput?.addEventListener("change", updateGuestFields);

  /*
   * Submit RSVP.
   */
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form || !button) return;

    errorMessage?.setAttribute("hidden", "");

    button.disabled = true;
    button.textContent = sendingText;

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    console.log("Sending RSVP:", data);

    try {
      const response = await fetch(GOOGLE_SCRIPT_URL, {
        method: "POST",
        headers: {
          "Content-Type": "text/plain;charset=utf-8",
        },
        body: JSON.stringify(data),
      });

      if (!response.ok) {
        throw new Error(`Request failed with status ${response.status}`);
      }

      const result = await response.json();

      console.log("Google response:", result);

      if (!result.success) {
        throw new Error(result.error || "Google Apps Script returned an error");
      }

      const attendance = data.attendance;

      if (attendance === "Yes") {
        successYes?.removeAttribute("hidden");
        successNo?.setAttribute("hidden", "");
      } else {
        successNo?.removeAttribute("hidden");
        successYes?.setAttribute("hidden", "");
      }

      /*
       * Hide the form controls after successful submission.
       */
      form
        .querySelectorAll<HTMLElement>(
          "input, textarea, select, button, fieldset, label"
        )
        .forEach((element) => {
          element.style.display = "none";
        });

      success?.removeAttribute("hidden");
    } catch (error) {
      console.error("RSVP error:", error);

      button.disabled = false;
      button.textContent = submitText;

      errorMessage?.removeAttribute("hidden");
    }
  });
</script>

<style>
  /* =========================================================
     SECTION
     ========================================================= */

  .rsvp-section {
    position: relative;
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }

  /* =========================================================
     HEADER
     ========================================================= */

  .rsvp-eyebrow {
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .rsvp-heading {
    margin-top: 0.75rem;
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 2.5rem;
    line-height: 1.15;
    color: var(--color-heading);
  }

  .rsvp-intro {
    max-width: 28rem;
    margin: 1.25rem auto 0;
    font-family: "DM Sans", sans-serif;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  /* =========================================================
     FORM CARD
     ========================================================= */

  .rsvp-form {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-sage);
    border-radius: 2rem;
    background: var(--color-surface);
    padding: 1.5rem;
    box-shadow: 0 20px 60px
      color-mix(in srgb, var(--color-heading) 8%, transparent);
    backdrop-filter: blur(12px);
  }

  .rsvp-form-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rsvp-decoration {
    position: absolute;
    pointer-events: none;
    border: 1px solid var(--color-sage);
    border-radius: 9999px;
  }

  .rsvp-decoration-top {
    top: -3rem;
    right: -3rem;
    width: 8rem;
    height: 8rem;
    opacity: 0.4;
  }

  .rsvp-decoration-bottom {
    bottom: -4rem;
    left: -4rem;
    width: 9rem;
    height: 9rem;
    opacity: 0.5;
  }

  /* =========================================================
     LABELS
     ========================================================= */

  .rsvp-label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-forest);
  }

  .rsvp-legend {
    margin-bottom: 0.75rem;
  }

  .rsvp-second-label {
    margin-top: 1.25rem;
  }

  /* =========================================================
     INPUTS
     ========================================================= */

  .rsvp-input,
  .rsvp-select {
    width: 100%;
    border: 1px solid var(--color-sage);
    border-radius: 0.75rem;
    background: var(--color-surface-soft);
    padding: 0.875rem 1.25rem;
    font-family: "DM Sans", sans-serif;
    color: var(--color-heading);
    outline: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .rsvp-input::placeholder {
    color: var(--color-secondary);
    opacity: 0.55;
  }

  .rsvp-input:focus,
  .rsvp-select:focus {
    border-color: var(--color-primary);
    background: var(--color-surface);
    box-shadow: 0 0 0 4px
      color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  .rsvp-textarea {
    resize: vertical;
  }

  .rsvp-select {
    width: auto;
    min-width: 5rem;
    cursor: pointer;
  }

  /* =========================================================
     ATTENDANCE CARDS
     ========================================================= */

  .rsvp-choice {
    display: block;
    cursor: pointer;
  }

  .rsvp-choice-card {
    height: 100%;
    border: 1px solid var(--color-sage);
    border-radius: 1.25rem;
    background: var(--color-surface-soft);
    padding: 1.25rem;
    text-align: center;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .rsvp-choice:hover .rsvp-choice-card {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    background: var(--color-surface);
  }

  .rsvp-choice input:checked + .rsvp-choice-card {
    border-color: var(--color-primary);
    background: var(--color-surface-soft);
    box-shadow: 0 4px 16px
      color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .rsvp-choice input:focus-visible + .rsvp-choice-card {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .rsvp-choice-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0 auto 0.75rem;
    border-radius: 9999px;
    background: color-mix(
      in srgb,
      var(--color-primary) 18%,
      var(--color-surface)
    );
    font-size: 1.5rem;
    color: var(--color-primary-hover);
    transition: transform 0.3s ease;
  }

  .rsvp-choice:hover .rsvp-choice-icon,
  .rsvp-choice input:checked + .rsvp-choice-card .rsvp-choice-icon {
    transform: scale(1.08);
  }

  .rsvp-choice-title {
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--color-heading);
  }

  .rsvp-choice-description {
    margin-top: 0.25rem;
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    color: var(--color-text);
  }

  /* =========================================================
     SECOND GUEST
     ========================================================= */

  .rsvp-guest-two {
    border: 1px solid black;
    border-radius: 1.25rem;

    padding: 1.25rem;
  }

  /* =========================================================
     PLAYLIST HINT
     ========================================================= */

  .rsvp-hint {
    margin-top: 0.5rem;
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    color: var(--color-text);
    opacity: 0.8;
  }

  /* =========================================================
     SUBMIT BUTTON
     ========================================================= */

  .rsvp-submit {
    width: 100%;
    margin-top: 0.5rem;
    border: 0;
    border-radius: 9999px;
    background: var(--color-primary);
    padding: 1rem;
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-surface);
    box-shadow: 0 2px 6px
      color-mix(in srgb, var(--color-heading) 8%, transparent);
    transition:
      transform 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .rsvp-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    background: var(--color-primary-hover);
    color: var(--color-surface);
    box-shadow: 0 8px 20px
      color-mix(in srgb, var(--color-heading) 12%, transparent);
  }

  .rsvp-submit:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .rsvp-submit:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  /* =========================================================
     SUCCESS AND ERROR
     ========================================================= */

  .rsvp-success {
    border: 1px solid var(--color-sage);
    border-radius: 1.75rem;
    background: var(--color-surface-soft);
    padding: 2.25rem 1.5rem;
    text-align: center;
  }

  .rsvp-success-title {
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 1.875rem;
    line-height: 1.3;
    color: var(--color-heading);
  }

  .rsvp-success-message {
    max-width: 28rem;
    margin: 0.75rem auto 0;
    font-family: "DM Sans", sans-serif;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .rsvp-error {
    border: 1px solid #fecaca;
    border-radius: 1rem;
    background: #fef2f2;
    padding: 1.25rem;
    text-align: center;
    font-family: "DM Sans", sans-serif;
    font-size: 0.875rem;
    color: #b91c1c;
  }

  /* Respect the native hidden attribute. */
  [hidden] {
    display: none !important;
  }

  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (min-width: 768px) {
    .rsvp-form {
      padding: 2.5rem;
    }
  }

  @media (max-width: 767px) {
    .rsvp-section {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .rsvp-heading {
      font-size: 2.25rem;
    }
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .rsvp-input,
    .rsvp-select,
    .rsvp-choice-card,
    .rsvp-choice-icon,
    .rsvp-submit {
      transition: none !important;
    }
  }
</style>

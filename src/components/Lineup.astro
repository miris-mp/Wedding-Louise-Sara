---
import { getTranslations, type Locale } from "../i18n/utils";
import { timelineData } from "@data/timelineData";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);

const icons: Record<string, string> = {
  heart: "♥",
  camera: "⌾",
  glass: "♢",
  utensils: "♨",
  music: "♪",
  cake: "✦",
  car: "→",
};
---

<section id="lineup" class="lineup-section relative py-14 md:py-20">
  <div class="relative z-10 mx-auto max-w-5xl px-6">

    <!-- Header -->
    <div class="mb-14 text-center md:mb-20">
      <p class="lineup-eyebrow">
        {t.lineup.eyebrow}
      </p>

      <h2 class="lineup-heading">
        {t.lineup.title}
      </h2>

      <div class="lineup-divider"></div>

      <p class="lineup-intro">
        {t.lineup.intro}
      </p>
    </div>

    <!-- Timeline -->
    <div class="timeline">
      {
        timelineData.map((event, index) => {
          const translation =
            t.lineup.events[
              event.id as keyof typeof t.lineup.events
            ];

          const isEven = index % 2 === 0;

          return (
            <article
              class:list={[
                "timeline-item",
                isEven ? "timeline-item-even" : "timeline-item-odd",
                event.icon === "heart" && "timeline-item-romantic",
              ]}
            >
              <!-- Content -->
              <div class="timeline-content">
                <p class="timeline-time">
                  {event.time}
                </p>

                <h3 class="timeline-title">
                  {translation.title}
                </h3>

                <p class="timeline-description">
                  {translation.description}
                </p>
              </div>

              <!-- Icon -->
              <div class="timeline-marker" aria-hidden="true">
                <span class="timeline-icon">
                  {icons[event.icon]}
                </span>
              </div>

              <!-- Empty side on alternating layout -->
              <div class="timeline-spacer"></div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  :global(:root) {
    --color-rose: #cf8981;
    --color-ivory: #f2e6da;
    --color-peach: #dfa688;
    --color-sage: #7e9b86;
    --color-forest: #2f4a3f;

    --color-surface: #fffdf9;
    --color-surface-soft: #f8eee8;

    --color-text: #496158;
    --color-text-muted: #6f8078;

    --color-primary-hover: #bd746c;

    --color-border: rgba(47, 74, 63, 0.14);
    --color-border-soft: rgba(126, 155, 134, 0.25);

    --color-highlight: rgba(207, 137, 129, 0.15);
    --color-sage-soft: rgba(126, 155, 134, 0.14);
    --color-peach-soft: rgba(223, 166, 136, 0.18);
  }

  /* =========================
     SECTION
     ========================= */

  .lineup-section {
    position: relative;

    margin-top: 3.5rem;
    margin-bottom: 3.5rem;

    background: var(--color-ivory);
  }

  /* Top diagonal */

  .lineup-section::before {
    content: "";

    position: absolute;
    top: -3.5rem;
    left: 0;

    width: 100%;
    height: 3.5rem;

    background: var(--color-ivory);

    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  /* Bottom diagonal */

  .lineup-section::after {
    content: "";

    position: absolute;
    bottom: -3.5rem;
    left: 0;

    width: 100%;
    height: 3.5rem;

    background: var(--color-ivory);

    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  /* =========================
     HEADER
     ========================= */

  .lineup-eyebrow {
    margin: 0;

    font-family: "DM Sans", sans-serif;
    font-size: 0.7rem;
    font-weight: 600;

    letter-spacing: 0.3em;
    text-transform: uppercase;

    color: var(--color-sage);
  }

  .lineup-heading {
    margin-top: 0.75rem;

    font-family: "DM Serif Display", Georgia, serif;
    font-size: 2.5rem;
    line-height: 1.15;

    color: var(--color-forest);
  }

  .lineup-divider {
    width: 3rem;
    height: 0.25rem;

    margin: 1rem auto 0;

    border-radius: 999px;

    background: linear-gradient(
      90deg,
      var(--color-rose),
      var(--color-peach)
    );
  }

  .lineup-intro {
    max-width: 42rem;

    margin: 1.25rem auto 0;

    font-family: "DM Sans", sans-serif;
    font-size: 1rem;
    line-height: 1.75;

    color: var(--color-text);
  }

  /* =========================
     TIMELINE
     ========================= */

  .timeline {
    position: relative;

    margin: 0 auto;

    max-width: 900px;
  }

  /*
   * Central line
   */

  .timeline::before {
    content: "";

    position: absolute;

    top: 0;
    bottom: 0;
    left: 50%;

    width: 2px;

    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--color-sage) 8%,
      var(--color-sage) 92%,
      transparent 100%
    );

    transform: translateX(-50%);
  }

  /*
   * Timeline row
   */

  .timeline-item {
    position: relative;

    display: grid;

    grid-template-columns: 1fr 80px 1fr;

    min-height: 180px;

    align-items: center;
  }

  /*
   * Content
   */

  .timeline-content {
    position: relative;

    padding: 1.5rem 2rem;

    transition:
      transform 0.25s ease,
      background-color 0.25s ease;
  }

  .timeline-item-even .timeline-content {
    grid-column: 1;

    text-align: right;

    margin-right: 0.75rem;
  }

  .timeline-item-odd .timeline-content {
    grid-column: 3;

    text-align: left;

    margin-left: 0.75rem;
  }

  /*
   * Very subtle alternating surfaces
   */

  .timeline-item-even .timeline-content {
    background: rgba(255, 253, 249, 0.55);

    border-radius: 1rem 0.25rem 1rem 1rem;
  }

  .timeline-item-odd .timeline-content {
    background: rgba(248, 238, 232, 0.5);

    border-radius: 0.25rem 1rem 1rem 1rem;
  }

  .timeline-content:hover {
    transform: translateY(-2px);
  }

  /*
   * Marker
   */

  .timeline-marker {
    z-index: 2;

    grid-column: 2;
    grid-row: 1;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 64px;
    height: 64px;

    margin: 0 auto;

    border: 5px solid var(--color-ivory);

    border-radius: 9999px;

    background: var(--color-peach);

    box-shadow:
      0 4px 14px rgba(47, 74, 63, 0.14);
  }

  /*
   * Alternate marker colors
   *
   * Peach is the default.
   * Sage adds a natural garden feel.
   * Romantic moments use dusty rose.
   */

  .timeline-item:nth-child(3n) .timeline-marker {
    background: var(--color-sage);
  }

  .timeline-item-romantic .timeline-marker {
    background: var(--color-rose);
  }

  .timeline-icon {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    font-family: Georgia, serif;

    font-size: 1.45rem;

    color: var(--color-surface);
  }

  /*
   * Time
   */

  .timeline-time {
    margin: 0;

    font-family: "DM Sans", sans-serif;

    font-size: 0.7rem;
    font-weight: 600;

    letter-spacing: 0.25em;
    text-transform: uppercase;

    color: var(--color-sage);
  }

  /*
   * Title
   */

  .timeline-title {
    margin-top: 0.4rem;

    font-family: "DM Serif Display", Georgia, serif;

    font-size: 1.75rem;
    line-height: 1.2;

    color: var(--color-forest);
  }

  /*
   * Description
   */

  .timeline-description {
    max-width: 300px;

    margin-top: 0.6rem;

    font-family: "DM Sans", sans-serif;

    font-size: 0.875rem;
    line-height: 1.7;

    color: var(--color-text);
  }

  .timeline-item-even .timeline-description {
    margin-left: auto;
  }

  /*
   * Small decorative accent
   */

  .timeline-item-even .timeline-content::after {
    content: "";

    position: absolute;

    right: -0.4rem;
    bottom: 1rem;

    width: 0.45rem;
    height: 0.45rem;

    border-radius: 50%;

    background: var(--color-peach);
  }

  .timeline-item-odd .timeline-content::after {
    content: "";

    position: absolute;

    left: -0.4rem;
    bottom: 1rem;

    width: 0.45rem;
    height: 0.45rem;

    border-radius: 50%;

    background: var(--color-rose);
  }

  /*
   * Empty column
   */

  .timeline-spacer {
    grid-row: 1;
  }

  .timeline-item-even .timeline-spacer {
    grid-column: 3;
  }

  .timeline-item-odd .timeline-spacer {
    grid-column: 1;
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 767px) {
    .lineup-section {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .lineup-section::before {
      top: -2.5rem;
      height: 2.5rem;
    }

    .lineup-section::after {
      bottom: -2.5rem;
      height: 2.5rem;
    }

    .lineup-heading {
      font-size: 2.25rem;
    }

    .timeline {
      padding-left: 3.5rem;
    }

    .timeline::before {
      left: 20px;

      transform: none;
    }

    .timeline-item {
      display: block;

      min-height: auto;

      padding-bottom: 3.5rem;
    }

    .timeline-item:last-child {
      padding-bottom: 0;
    }

    .timeline-content,
    .timeline-item-even .timeline-content,
    .timeline-item-odd .timeline-content {
      padding: 1rem 1.1rem 1rem 1.5rem;

      margin: 0;

      text-align: left;

      border-radius: 0.25rem 1rem 1rem 1rem;
    }

    .timeline-marker {
      position: absolute;

      top: 0;
      left: -3.5rem;

      width: 42px;
      height: 42px;

      border-width: 4px;
    }

    .timeline-icon {
      font-size: 1rem;
    }

    .timeline-title {
      font-size: 1.5rem;
    }

    .timeline-description {
      max-width: none;

      margin-left: 0 !important;
    }

    .timeline-spacer {
      display: none;
    }

    .timeline-item-even .timeline-content::after,
    .timeline-item-odd .timeline-content::after {
      display: none;
    }
  }
</style>
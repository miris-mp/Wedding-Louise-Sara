---
import { getTranslations, type Locale } from "../i18n/utils";
import { timelineData } from "@data/timelineData";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);

const icons: Record<string, string> = {
  happyHour: "🥂",
  // U+2764 + U+FE0F forces the colored emoji version
  heart: "\u2764\uFE0F",
  camera: "⌾",
  glass: "♢",
  utensils: "♨",
  music: "♪",
  cake: "✦",
  car: "→",
};
---

<section id="lineup" class="lineup-section relative py-14 md:py-20">
  <div class="relative z-10 mx-auto max-w-5xl px-6">
    <!-- Header -->
    <div class="mb-14 text-center md:mb-20">
      <p class="lineup-eyebrow">
        {t.lineup.eyebrow}
      </p>

      <h2 class="lineup-heading">
        {t.lineup.title}
      </h2>

      <div class="lineup-divider"></div>

      <p class="lineup-intro">
        {t.lineup.intro}
      </p>
    </div>

    <!-- Timeline -->
    <div class="timeline">
      {
        timelineData.map((event, index) => {
          const translation =
            t.lineup.events[event.id as keyof typeof t.lineup.events];

          const dayLabel =
            t.lineup.days[event.day as keyof typeof t.lineup.days];

          const isEven = index % 2 === 0;

          // Show a label whenever the day changes (and for the first item)
          const prev = timelineData[index - 1];
          const showDayLabel = !prev || prev.day !== event.day;

          return (
            <>
              {showDayLabel && (
                <div class="timeline-day-label">{dayLabel}</div>
              )}

              <article
                class:list={[
                  "timeline-item",
                  isEven ? "timeline-item-even" : "timeline-item-odd",
                  event.icon === "heart" && "timeline-item-romantic",
                ]}
              >
                <!-- Content -->
                <div class="timeline-content">
                  <p class="timeline-time">{event.time}</p>

                  <h3 class="timeline-title">
                    {translation.title}
                  </h3>

                  <p class="timeline-description">
                    {translation.description}
                  </p>
                </div>

                <!-- Icon -->
                <div class="timeline-marker" aria-hidden="true">
                  <span class="timeline-icon">
                    {icons[event.icon]}
                  </span>
                </div>

                <!-- Empty side on alternating layout -->
                <div class="timeline-spacer"></div>
              </article>
            </>
          );
        })
      }
    </div>

    <div class="rounded-3xl bg-(--color-surface-soft) p-5 md:p-6">
      <p
        class="font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-[#4f6b58]"
      >
        {t.lineup.pending}
      </p>
    </div>
  </div>
</section>

<style>
  /* =========================================================
     SECTION
     ========================================================= */

  .lineup-section {
    position: relative;

    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }

  /* =========================================================
     HEADER
     ========================================================= */

  .lineup-eyebrow {
    margin: 0;

    font-family: "DM Sans", sans-serif;

    font-size: 0.7rem;
    font-weight: 600;

    letter-spacing: 0.3em;
    text-transform: uppercase;

    color: var(--color-secondary);
  }

  .lineup-heading {
    margin-top: 0.75rem;

    font-family: "DM Serif Display", Georgia, serif;

    font-size: 2.5rem;
    line-height: 1.15;

    color: var(--color-heading);
  }

  .lineup-divider {
    width: 3rem;
    height: 0.22rem;

    margin: 1rem auto 0;

    border-radius: 999px;

    background: var(--color-primary);
  }

  .lineup-intro {
    max-width: 42rem;

    margin: 1.25rem auto 0;

    font-family: "DM Sans", sans-serif;

    font-size: 1rem;
    line-height: 1.75;

    color: var(--color-text);
  }

  /* =========================================================
     TIMELINE
     ========================================================= */

  .timeline {
    position: relative;

    max-width: 900px;

    margin: 0 auto 3rem;
  }

  /*
   * Central timeline line.
   * Intentionally subtle: the rose markers are the visual focus.
   */
  .timeline::before {
    content: "";

    position: absolute;

    top: 0;
    bottom: 0;
    left: 50%;

    width: 1px;

    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(126, 155, 134, 0.45) 10%,
      rgba(126, 155, 134, 0.45) 90%,
      transparent 100%
    );

    transform: translateX(-50%);
  }

  /* =========================================================
     DAY LABEL
     ========================================================= */

     .timeline-day-label {
  position: relative;
  z-index: 2;

  width: fit-content;

  margin: 2.5rem auto 1.75rem;
  padding: 0.6rem 1.6rem;

  border: 1px solid var(--color-sage);
  border-radius: 999px;

  background: var(--color-surface);
  color: var(--color-sage);
  box-shadow: 0 6px 18px rgba(47, 74, 63, 0.18);

  font-family: "DM Sans", sans-serif;
  font-size: 0.85rem;
  font-weight: 700;

  letter-spacing: 0.25em;
  text-transform: uppercase;
}

  /* No extra space above the very first label */
  .timeline > .timeline-day-label:first-child {
    margin-top: 0;
  }

  /* Timeline row */
  .timeline-item {
    position: relative;

    display: grid;

    grid-template-columns: 1fr 80px 1fr;

    min-height: 180px;

    align-items: center;
  }

  /* =========================================================
     CONTENT CARDS
     ========================================================= */

  .timeline-content {
    position: relative;

    padding: 1.5rem 2rem;

    border: 1px solid var(--color-sage);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* Left side */
  .timeline-item-even .timeline-content {
    grid-column: 1;

    margin-right: 0.75rem;

    text-align: right;
    border: 1px solid var(--color-sage);

    background: var(--color-surface-soft);

    border-radius: 1.25rem 0.35rem 1.25rem 1.25rem;
  }

  /* Right side */
  .timeline-item-odd .timeline-content {
    grid-column: 3;

    margin-left: 0.75rem;

    text-align: left;

    background: rgba(255, 253, 250, 0.7);

    border-radius: 0.35rem 1.25rem 1.25rem 1.25rem;
  }

  .timeline-content:hover {
    transform: translateY(-2px);

    box-shadow: 0 8px 24px rgba(47, 74, 63, 0.07);
  }

  /* Romantic event gets a slightly stronger wedding-colored border */
  .timeline-item-romantic .timeline-content {
    border-color: var(--color-primary-hover);
  }

  /* =========================================================
     MARKER
     ========================================================= */

  .timeline-marker {
    z-index: 2;

    grid-column: 2;
    grid-row: 1;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 64px;
    height: 64px;

    margin: 0 auto;

    border: 5px solid var(--color-section-bg);

    border-radius: 9999px;

    /* Rose is the main wedding identity */
    background: var(--color-surface-soft);

    box-shadow: 0 5px 18px rgba(207, 137, 129, 0.25);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .timeline-item:hover .timeline-marker {
    transform: scale(1.05);

    box-shadow: 0 7px 22px rgba(207, 137, 129, 0.3);
  }

  .timeline-item-romantic .timeline-marker {
    background: var(--color-primary);

    box-shadow: 0 7px 24px rgba(207, 137, 129, 0.38);
  }

  .timeline-icon {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    font-family: Georgia, serif;

    font-size: 1.45rem;

    color: var(--color-surface);
  }

  /* =========================================================
     TIME
     ========================================================= */

     .timeline-time {
  display: inline-block;

  margin: 0;
  padding: 0.25rem 0.75rem;

  border-radius: 999px;

  background: rgba(207, 137, 129, 0.14);

  font-family: "DM Sans", sans-serif;
  font-size: 0.9rem;
  font-weight: 700;

  letter-spacing: 0.15em;

  color: var(--color-primary-hover);
}

.timeline-time-day {
  opacity: 0.8;
}

  .timeline-item-romantic .timeline-time {
    color: var(--color-primary-hover);
  }

  /* =========================================================
     TITLE
     ========================================================= */

  .timeline-title {
    margin-top: 0.4rem;

    font-family: "DM Serif Display", Georgia, serif;

    font-size: 1.75rem;
    line-height: 1.2;

    color: var(--color-heading);
  }

  .timeline-item-romantic .timeline-title {
    color: var(--color-primary-hover);
  }

  /* =========================================================
     DESCRIPTION
     ========================================================= */

  .timeline-description {
    max-width: 300px;

    margin-top: 0.6rem;

    font-family: "DM Sans", sans-serif;

    font-size: 0.875rem;
    line-height: 1.7;

    color: var(--color-text);
  }

  .timeline-item-even .timeline-description {
    margin-left: auto;
  }

  

  

  /* =========================================================
     EMPTY COLUMN
     ========================================================= */

  .timeline-spacer {
    grid-row: 1;
  }

  .timeline-item-even .timeline-spacer {
    grid-column: 3;
  }

  .timeline-item-odd .timeline-spacer {
    grid-column: 1;
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 767px) {
    .lineup-section {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .lineup-heading {
      font-size: 2.25rem;
    }

    .timeline {
      padding-left: 3.5rem;
    }

    .timeline::before {
      left: 20px;

      transform: none;
    }

    .timeline-day-label {
      margin-left: 0;
      margin-bottom: 1.25rem;
    }

    .timeline-item {
      display: block;

      min-height: auto;

      padding-bottom: 3.5rem;
    }

    .timeline-item:last-child {
      padding-bottom: 0;
    }

    .timeline-content,
    .timeline-item-even .timeline-content,
    .timeline-item-odd .timeline-content {
      padding: 1rem 1.1rem 1rem 1.5rem;

      margin: 0;

      text-align: left;

      border-radius: 0.35rem 1.25rem 1.25rem 1.25rem;
    }

    .timeline-marker {
      position: absolute;

      top: 0;
      left: -3.5rem;

      width: 42px;
      height: 42px;

      border-width: 4px;
    }

    .timeline-icon {
      font-size: 1rem;
    }

    .timeline-title {
      font-size: 1.5rem;
    }

    .timeline-description {
      max-width: none;

      margin-left: 0 !important;
    }

    .timeline-spacer {
      display: none;
    }

    .timeline-item-even .timeline-content::after,
    .timeline-item-odd .timeline-content::after {
      display: none;
    }
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .timeline-content,
    .timeline-marker {
      transition: none !important;
    }
  }
</style>
---
import { getTranslations, type Locale } from "../i18n/utils";
import {
  pugliaItineraries,
  type PugliaItinerary,
} from "@data/pugliaItineraries";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);

const mapsUrl = (query: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query + ", Italy")}`;
---

<section id="goto" class="puglia-guide relative py-14 md:py-20">
  <div class="relative z-10 mx-auto max-w-6xl px-6">

    <!-- Intro -->
    <div class="mb-10 text-center md:mb-12">
      <p
        class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-[var(--color-sage)]"
      >
        {t.goto.title}
      </p>

      <h2
        class="mt-3 font-serif text-4xl text-[var(--color-heading)] md:text-5xl"
      >
        {t.goto.subtitle}
      </h2>

      <div
        class="mx-auto mt-4 h-1 w-12 rounded-full bg-[var(--color-primary)]"
      ></div>

      <p
        class="mx-auto mt-5 max-w-2xl font-sans text-base leading-7 text-[var(--color-text)]"
      >
        {t.goto.intro}
      </p>
    </div>

    <!-- Itineraries -->
    <div class="space-y-6">
      {
        pugliaItineraries.map((itinerary, itineraryIndex) => (
          <details
            class="guide-card group overflow-hidden rounded-[2rem] border border-[var(--color-border-soft)] bg-[var(--color-surface)]/90 shadow-md backdrop-blur transition-all duration-500 ease-out hover:scale-[1.005] hover:shadow-xl"
            open={itineraryIndex === 0}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 p-6 md:p-8">
              <div class="flex min-w-0 items-center gap-4">

                <!-- Number -->
                <div
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[var(--color-wedding-soft)] font-serif text-lg text-[var(--color-heading)]"
                >
                  {String(itineraryIndex + 1).padStart(2, "0")}
                </div>

                <div class="min-w-0">
                  <p
                    class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[var(--color-sage)]"
                  >
                    {itinerary.id === "bari-central"
                      ? t.goto.itinerary.bariCentral.label
                      : itinerary.id === "lecce-salento"
                        ? t.goto.itinerary.lecceSalento.label
                        : t.goto.itinerary.salentoDeepDive.label}
                  </p>

                  <h3
                    class="mt-1 font-serif text-2xl text-[var(--color-heading)] md:text-3xl"
                  >
                    {itinerary.title}
                  </h3>
                </div>
              </div>

              <!-- Plus -->
              <span
                class="guide-plus flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[var(--color-border-soft)] text-[var(--color-sage)] transition-all duration-500 ease-out group-open:rotate-45 group-open:border-[var(--color-primary)] group-open:bg-[var(--color-primary)] group-open:text-[var(--color-surface)]"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-5 w-5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 5v14M5 12h14"
                  />
                </svg>
              </span>
            </summary>

            <div class="guide-content">
              <div
                class="border-t border-[var(--color-border-soft)] px-6 pb-8 pt-7 md:px-8 md:pb-10"
              >

                <!-- Focus -->
                <div
                  class="rounded-[1.5rem] bg-[var(--color-surface-soft)] p-5 md:p-6"
                >
                  <p
                    class="font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-[var(--color-sage)]"
                  >
                    {t.goto.focus}
                  </p>

                  <p
                    class="mt-2 max-w-3xl font-sans text-sm leading-7 text-[var(--color-text)]"
                  >
                    {itinerary.focus}
                  </p>
                </div>

                <!-- Sleeping bases -->
                <div class="mt-6">
                  <div class="mb-4 flex items-center gap-3">
                    <span class="text-[var(--color-sage)]">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        class="h-5 w-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"
                        />
                      </svg>
                    </span>

                    <h4
                      class="font-serif text-xl text-[var(--color-heading)]"
                    >
                      {t.goto.sleepingBases}
                    </h4>
                  </div>

                  <div class="grid gap-4 md:grid-cols-2">
                    <div
                      class="rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-surface)] p-5"
                    >
                      <p
                        class="font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-[var(--color-sage)]"
                      >
                        {itinerary.bases.base1Nights}
                      </p>

                      <p
                        class="mt-2 font-serif text-xl text-[var(--color-heading)]"
                      >
                        {itinerary.bases.base1}
                      </p>
                    </div>

                    <div
                      class="rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-surface)] p-5"
                    >
                      <p
                        class="font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-[var(--color-sage)]"
                      >
                        {itinerary.bases.base2Nights}
                      </p>

                      <p
                        class="mt-2 font-serif text-xl text-[var(--color-heading)]"
                      >
                        {itinerary.bases.base2}
                      </p>
                    </div>
                  </div>
                </div>

                <!-- Days -->
                <div class="mt-8">
                  <div class="mb-5 flex items-center gap-3">
                    <span class="text-[var(--color-sage)]">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        class="h-5 w-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M8 2v4M16 2v4M3 10h18M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"
                        />
                      </svg>
                    </span>

                    <h4
                      class="font-serif text-xl text-[var(--color-heading)]"
                    >
                      {itinerary.days.length} {t.goto.days}
                    </h4>
                  </div>

                  <div class="space-y-4">
                    {
                      itinerary.days.map((day) => (
                        <article
                          class="rounded-[1.5rem] border border-[var(--color-border-soft)] bg-[var(--color-surface-soft)] p-5 md:p-6"
                        >

                          <!-- Day heading -->
                          <div class="flex items-start gap-4">
                            <div
                              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-wedding-soft)] font-sans text-xs font-semibold text-[var(--color-heading)]"
                            >
                              {day.day}
                            </div>

                            <div class="min-w-0">
                              <p
                                class="font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-[var(--color-sage)]"
                              >
                                {t.goto.day} {day.day}
                              </p>

                              <h5
                                class="mt-1 font-serif text-xl leading-tight text-[var(--color-heading)] md:text-2xl"
                              >
                                {day.title}
                              </h5>
                            </div>
                          </div>

                          <!-- City / Beach -->
                          <div class="mt-5 grid gap-5 md:grid-cols-2">

                            <!-- City -->
                            <div>
                              <p
                                class="font-sans text-[10px] font-medium uppercase tracking-[0.18em] text-[var(--color-sage)]"
                              >
                                {t.goto.city}
                              </p>

                              <h6
                                class="mt-1 font-serif text-lg text-[var(--color-heading)]"
                              >
                                {day.city.name}
                              </h6>

                              <p
                                class="mt-2 font-sans text-sm leading-6 text-[var(--color-text)]"
                              >
                                {day.city.description}
                              </p>

                              <a
                                href={mapsUrl(day.city.name)}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-3 inline-flex font-sans text-xs font-medium uppercase tracking-[0.15em] text-[var(--color-primary)] transition-colors hover:text-[var(--color-primary-hover)]"
                              >
                                {t.goto.viewOnMap}
                              </a>
                            </div>

                            <!-- Beach -->
                            <div
                              class="border-t border-[var(--color-border-soft)] pt-5 md:border-l md:border-t-0 md:pl-5 md:pt-0"
                            >
                              <p
                                class="font-sans text-[10px] font-medium uppercase tracking-[0.18em] text-[var(--color-sage)]"
                              >
                                {t.goto.beach}
                              </p>

                              <h6
                                class="mt-1 font-serif text-lg text-[var(--color-heading)]"
                              >
                                {day.beach.name}
                              </h6>

                              <p
                                class="mt-2 font-sans text-sm leading-6 text-[var(--color-text)]"
                              >
                                {day.beach.description}
                              </p>

                              <a
                                href={mapsUrl(day.beach.name)}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-3 inline-flex font-sans text-xs font-medium uppercase tracking-[0.15em] text-[var(--color-primary)] transition-colors hover:text-[var(--color-primary-hover)]"
                              >
                                {t.goto.viewOnMap}
                              </a>
                            </div>

                          </div>
                        </article>
                      ))
                    }
                  </div>
                </div>

                <!-- Featured beaches -->
                <div
                  class="mt-8 rounded-[1.5rem] bg-[var(--color-highlight)] p-6 md:p-7"
                >
                  <p
                    class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[var(--color-sage)]"
                  >
                    {t.goto.comparison.featuredBeaches}
                  </p>

                  <div class="mt-3 flex flex-wrap gap-2">
                    {
                      itinerary.keyBeaches.map((beach) => (
                        <span
                          class="rounded-full border border-[var(--color-border-soft)] bg-[var(--color-surface)] px-3 py-1.5 font-sans text-xs text-[var(--color-text)]"
                        >
                          {beach}
                        </span>
                      ))
                    }
                  </div>
                </div>

              </div>
            </div>
          </details>
        ))
      }
    </div>

    <!-- Comparison -->
    <div class="mt-10 text-center">
      <p
        class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-[var(--color-sage)]"
      >
        {t.goto.comparison.subtitle}
      </p>

      <h3
        class="mt-2 font-serif text-3xl text-[var(--color-heading)] md:text-4xl"
      >
        {t.goto.comparison.title}
      </h3>
    </div>

  </div>
</section>

<style>
  .puglia-guide {
    position: relative;
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }

  .puglia-guide::before {
    content: "";
    position: absolute;
    top: -3.5rem;
    left: 0;
    width: 100%;
    height: 3.5rem;
    background: var(--color-surface);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  .puglia-guide::after {
    content: "";
    position: absolute;
    bottom: -3.5rem;
    left: 0;
    width: 100%;
    height: 3.5rem;
    background: var(--color-surface);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  /* Smooth accordion animation */
  .guide-content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 300ms ease;
  }

  .guide-content > div {
    min-height: 0;
    overflow: hidden;
    transform: translateY(-8px);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .guide-card[open] .guide-content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .guide-card[open] .guide-content > div {
    transform: translateY(0);
  }

  /* Remove default marker */
  summary::-webkit-details-marker {
    display: none;
  }

  summary::marker {
    display: none;
  }

  /* Subtle hover scale */
  .guide-card {
    transform-origin: center;
    will-change: transform, box-shadow;
  }

  /* Smooth trigger interaction */
  .guide-card summary {
    transition:
      background-color 300ms ease,
      padding 300ms ease;
  }

  .guide-card summary:hover {
    background: var(--color-surface-soft);
  }

  /* Touch devices */
  @media (hover: none) {
    .guide-card:hover {
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .puglia-guide {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .puglia-guide::before {
      top: -2.5rem;
      height: 2.5rem;
    }

    .puglia-guide::after {
      bottom: -2.5rem;
      height: 2.5rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .guide-card,
    .guide-content,
    .guide-content > div,
    .guide-plus,
    .guide-card summary {
      transition: none !important;
    }
  }
</style>
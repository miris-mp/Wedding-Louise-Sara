---
interface Props {
  id?: string;
  venue: string;
  address: string;
  city: string;
  date: string;
  time: string;
  mapsUrl: string;
  embedUrl: string;
}

const { id, venue, address, city, date, time, mapsUrl, embedUrl } = Astro.props;
---

<section class="bg-stone-50 py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-16 text-center">
      <p class="text-sm uppercase tracking-[0.35em] text-stone-500">Join us</p>

      <h2 class="mt-4 font-serif text-5xl text-stone-800">
        Where We'll Say "I Do"
      </h2>

      <div class="mx-auto mt-6 h-px w-24 bg-stone-300"></div>
    </div>

    <div class="grid gap-16 lg:grid-cols-2 lg:items-center">
      <!-- Left -->
      <div>
        <h3 class="font-serif text-3xl text-stone-800">
          {venue}
        </h3>

        <p class="mt-6 text-lg leading-8 text-stone-600">
          {address}<br />
          {city}
        </p>

        <div class="my-8 h-px w-16 bg-stone-300"></div>

        <div class="space-y-4 text-stone-700">
          <p>
            <span class="font-medium">Date</span><br />
            {date}
          </p>

          <p>
            <span class="font-medium">Ceremony</span><br />
            {time}
          </p>
        </div>

        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-flex items-center rounded-full border border-stone-300 px-8 py-4 text-sm uppercase tracking-[0.2em] text-stone-700 transition hover:border-stone-800 hover:bg-stone-800 hover:text-white"
        >
          Open in Google Maps
        </a>
      </div>

      <!-- Right -->
      <div class="overflow-hidden rounded-[2rem] shadow-xl">
        <iframe
          src={embedUrl}
          width="100%"
          height="500"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          class="block"
        >
        </iframe>
      </div>
    </div>
  </div>
</section>

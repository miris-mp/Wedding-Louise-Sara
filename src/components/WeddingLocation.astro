---
import { locationWedding } from "../data/locationWedding";
import { getTranslations, type Locale } from "../i18n/utils";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);

const date = new Date(`${locationWedding.date}T${locationWedding.time}:00`);

const formattedDate = new Intl.DateTimeFormat(locale, {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(date);

const formattedTime = new Intl.DateTimeFormat(locale, {
  hour: "numeric",
  minute: "2-digit",
}).format(date);
---

<section id="location" class="location-section relative py-14 md:py-20">
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- Heading -->
    <div class="mb-10 text-center md:mb-12">
      <p
        class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-[var(--color-sage)]"
      >
        {t.location.eyebrow}
      </p>

      <h2
        class="mt-3 font-serif text-4xl text-[var(--color-heading)] md:text-5xl"
      >
        {t.location.title}
      </h2>

      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-[var(--color-primary)]">
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
      <!-- Location details -->
      <div
        class="rounded-[2rem] border border-[var(--color-border-soft)] bg-[var(--color-surface)] p-7 shadow-md md:p-9"
      >
        <p
          class="font-sans text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-sage)]"
        >
          {t.location.venue}
        </p>

        <h3
          class="mt-3 font-serif text-3xl text-[var(--color-heading)] md:text-4xl"
        >
          {locationWedding.venue}
        </h3>

        <p class="mt-4 font-sans text-base leading-7 text-[var(--color-text)]">
          {locationWedding.address}<br />
          {locationWedding.city}
        </p>

        <div class="my-7 h-px w-12 bg-[var(--color-primary)]"></div>

        <div class="grid gap-5 sm:grid-cols-2">
          <!-- Date -->
          <div>
            <p
              class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[var(--color-sage)]"
            >
              {t.location.date}
            </p>

            <p class="mt-1 font-serif text-xl text-[var(--color-heading)]">
              {formattedDate}
            </p>
          </div>

          <!-- Ceremony -->
          <div>
            <p
              class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[var(--color-sage)]"
            >
              {t.location.ceremony}
            </p>

            <p class="mt-1 font-serif text-xl text-[var(--color-heading)]">
              {formattedTime}
            </p>
          </div>
        </div>

        <!-- Maps button -->
        <a
          href={locationWedding.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center rounded-full bg-[var(--color-primary)] px-7 py-3.5 font-sans text-xs font-medium uppercase tracking-[0.2em] text-[var(--color-surface)] shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-[var(--color-primary-hover)] hover:shadow-md"
        >
          {t.location.openMaps}
        </a>
      </div>

      <!-- Map -->
      <div
        class="overflow-hidden rounded-[2rem] border-4 border-[var(--color-surface)] shadow-lg"
      >
        <iframe
          src={locationWedding.embedUrl}
          width="100%"
          height="430"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          class="block"
        >
        </iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .location-section {
    position: relative;
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }

  /* Top diagonal */
  .location-section::before {
    content: "";
    position: absolute;
    top: -3.5rem;
    left: 0;
    width: 100%;
    height: 3.5rem;
    background: var(--color-surface);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  /* Bottom diagonal */
  .location-section::after {
    content: "";
    position: absolute;
    bottom: -3.5rem;
    left: 0;
    width: 100%;
    height: 3.5rem;
    background: var(--color-surface);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  @media (max-width: 767px) {
    .location-section {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .location-section::before {
      top: -2.5rem;
      height: 2.5rem;
    }

    .location-section::after {
      bottom: -2.5rem;
      height: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .location-section a {
      transition: none !important;
    }
  }
</style>

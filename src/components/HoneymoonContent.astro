---
import { getTranslations, type Locale } from "../i18n/utils";
import { honeymoonData } from "../data/honeymoonData";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(locale);

const accountIt = {
  id: "italian",
  label: t.honeymoon.italianAccount,
  ...honeymoonData.italian,
};
const accountEn = {
  id: "english",
  label: t.honeymoon.englishAccount,
  ...honeymoonData.english,
};

const experiences = [
  {
    key: "ryokan",
    number: "01",
  },
  {
    key: "kaiseki",
    number: "02",
  },
  {
    key: "tokyoFood",
    number: "03",
  },
  {
    key: "kyoto",
    number: "04",
  },
];
---

<section id="honeymoon" class="honeymoon-section relative py-16 md:py-24">
  <div class="relative z-10 mx-auto max-w-5xl px-6">
    <!-- =====================================================
         INTRO
         ===================================================== -->

    <header class="honeymoon-header">
      <p class="honeymoon-eyebrow">
        {t.honeymoon.eyebrow}
      </p>

      <h2 class="honeymoon-heading">
        {t.honeymoon.title}
      </h2>

      <div class="honeymoon-divider"></div>

      <p class="honeymoon-intro">
        {t.honeymoon.intro}
      </p>
    </header>

    <!-- =====================================================
         WISHLIST
         ===================================================== -->

    <div class="wishlist-section">
      <div class="wishlist-header">
        <p class="wishlist-eyebrow">
          {t.honeymoon.wishlistTitle}
        </p>

        <p class="wishlist-intro">
          {t.honeymoon.wishlistIntro}
        </p>
      </div>

      <div class="wishlist-grid">
        {
          experiences.map((experience) => {
            const item =
              t.honeymoon.experiences[
                experience.key as keyof typeof t.honeymoon.experiences
              ];

            return (
              <article class="experience-card">
                <span class="experience-number">{experience.number}</span>

                <div class="experience-content">
                  <h3 class="experience-title">{item.title}</h3>

                  <p class="experience-description">{item.description}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>

    <!-- =====================================================
         BANK TRANSFER
         ===================================================== -->

    <div class="gift-section">
      <div class="gift-header">
        <p class="gift-eyebrow">
          {t.honeymoon.registryTitle}
        </p>

        <p class="gift-intro">
          {t.honeymoon.registryIntro}
        </p>
      </div>

      <div class="accounts-grid">
        <article class="account-card">
          <p class="account-label">{accountIt.label}</p>

          <div class="account-details">
            <div>
              <p class="detail-label">{t.honeymoon.ibanLabel}</p>

              <p id={`iban-${accountIt.id}`} class="iban">
                {accountIt.iban}
              </p>
            </div>

            {
              accountIt.bankName && (
                <div class="detail-block">
                  <p class="account-holder">
                    {t.honeymoon.BankName}: <span>{accountIt.bankName}</span>
                  </p>
                </div>
              )
            }

            <p class="account-holder">
              {t.honeymoon.accountHolder}: <span>{accountIt.accountName}</span>
            </p>
          </div>

          <button
            type="button"
            data-copy-iban={accountIt.id}
            class="copy-button"
          >
            {t.honeymoon.copyIban}
          </button>

          <p data-copied={accountIt.id} class="copied-message">
            {t.honeymoon.copied}
          </p>
        </article>
        <article class="account-card">
          <p class="account-label">{accountEn.label}</p>

          <div class="account-details">
            <div>
              <p class="detail-label">{t.honeymoon.accountNumber}</p>

              <p id={`iban-${accountEn.id}`} class="iban">
                {accountEn.accountNumber}
              </p>
            </div>

            {
              accountEn.sortCode && (
                <div class="detail-block">
                  <p class="account-holder">
                    {t.honeymoon.sortCode}: <span>{accountEn.sortCode}</span>
                  </p>
                </div>
              )
            }

            <p class="account-holder">
              {t.honeymoon.accountHolder}: <span>{accountIt.accountName}</span>
            </p>
          </div>

          <button
            type="button"
            data-copy-iban={accountEn.id}
            class="copy-button"
          >
            {t.honeymoon.copyIban}
          </button>

          <p data-copied={accountEn.id} class="copied-message">
            {t.honeymoon.copied}
          </p>
        </article>
      </div>

      <!-- =====================================================
           QR
           ===================================================== -->

      <article class="qr-card">
        <div class="qr-content">
          <p class="qr-eyebrow">
            {t.honeymoon.qrTitle}
          </p>

          <p class="qr-intro">
            {t.honeymoon.qrIntro}
          </p>
        </div>

        <div class="qr-image-wrapper">
          <img
            src={honeymoonData.qrCode}
            alt={t.honeymoon.qrAlt}
            class="qr-image"
          />
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-iban]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const accountId = button.dataset.copyIban;

        if (!accountId) return;

        const iban = document.querySelector(`#iban-${accountId}`);

        const copied = document.querySelector(`[data-copied="${accountId}"]`);

        if (!iban) return;

        await navigator.clipboard.writeText(iban.textContent?.trim() || "");

        copied?.classList.add("is-visible");

        setTimeout(() => {
          copied?.classList.remove("is-visible");
        }, 2500);
      });
    });
</script>

<style>
  /* =========================================================
     SECTION
     ========================================================= */

  .honeymoon-section {
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;

    background: var(--color-page-bg);
  }

  .honeymoon-section::before {
    content: "";

    position: absolute;

    top: -3.5rem;
    left: 0;

    width: 100%;
    height: 3.5rem;

    background: var(--color-page-bg);

    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  .honeymoon-section::after {
    content: "";

    position: absolute;

    bottom: -3.5rem;
    left: 0;

    width: 100%;
    height: 3.5rem;

    background: var(--color-page-bg);

    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  /* =========================================================
     INTRO
     ========================================================= */

  .honeymoon-header {
    max-width: 48rem;

    margin: 0 auto;

    text-align: center;
  }

  .honeymoon-eyebrow,
  .wishlist-eyebrow,
  .gift-eyebrow,
  .qr-eyebrow {
    margin: 0;

    font-family: "DM Sans", sans-serif;

    font-size: 0.7rem;
    font-weight: 600;

    letter-spacing: 0.3em;
    text-transform: uppercase;

    color: var(--color-secondary);
  }

  .honeymoon-heading {
    margin-top: 0.75rem;

    font-family: "DM Serif Display", Georgia, serif;

    font-size: 2.5rem;
    line-height: 1.15;

    color: var(--color-heading);
  }

  .honeymoon-divider {
    width: 3rem;
    height: 0.22rem;

    margin: 1rem auto 0;

    border-radius: 999px;

    background: var(--color-primary);
  }

  .honeymoon-intro {
    max-width: 42rem;

    margin: 2rem auto 0;

    font-family: "DM Sans", sans-serif;

    font-size: 0.95rem;
    line-height: 1.9;

    color: var(--color-text);
  }

  /* =========================================================
     WISHLIST
     ========================================================= */

  .wishlist-section {
    margin-top: 5rem;
  }

  .wishlist-header {
    max-width: 38rem;

    margin-bottom: 2rem;
  }

  .wishlist-intro {
    margin-top: 0.75rem;

    font-family: "DM Sans", sans-serif;

    font-size: 0.9rem;
    line-height: 1.8;

    color: var(--color-text);
  }

  .wishlist-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 1rem;
  }

  .experience-card {
    position: relative;

    display: flex;

    gap: 1.25rem;

    padding: 1.5rem;

    border: 1px solid var(--color-border);

    border-radius: 1.5rem;

    background: var(--color-surface);

    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .experience-card:hover {
    border-color: rgba(207, 137, 129, 0.3);

    box-shadow: 0 8px 24px rgba(47, 74, 63, 0.06);

    transform: translateY(-2px);
  }

  .experience-number {
    flex-shrink: 0;

    font-family: "DM Serif Display", Georgia, serif;

    font-size: 1.25rem;

    color: var(--color-primary);
  }

  .experience-title {
    margin: 0;

    font-family: "DM Serif Display", Georgia, serif;

    font-size: 1.25rem;
    line-height: 1.3;

    color: var(--color-heading);
  }

  .experience-description {
    margin-top: 0.6rem;

    font-family: "DM Sans", sans-serif;

    font-size: 0.85rem;
    line-height: 1.7;

    color: var(--color-text);
  }

  /* =========================================================
     GIFT / BANK DETAILS
     ========================================================= */

  .gift-section {
    margin-top: 5rem;
  }

  .gift-header {
    max-width: 42rem;

    margin-bottom: 2rem;
  }

  .gift-intro {
    margin-top: 0.75rem;

    font-family: "DM Sans", sans-serif;

    font-size: 0.9rem;
    line-height: 1.8;

    color: var(--color-text);
  }

  .accounts-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 1rem;
  }

  .account-card {
    padding: 1.75rem;

    border: 1px solid var(--color-border);

    border-radius: 1.5rem;

    background: var(--color-surface);

    box-shadow: 0 2px 8px rgba(47, 74, 63, 0.025);
  }

  .account-label {
    margin: 0;

    font-family: "DM Sans", sans-serif;

    font-size: 0.7rem;
    font-weight: 600;

    letter-spacing: 0.25em;
    text-transform: uppercase;

    color: var(--color-primary);
  }

  .account-details {
    margin-top: 1.5rem;
  }

  .detail-label {
    margin: 0;

    font-family: "DM Sans", sans-serif;

    font-size: 0.7rem;
    font-weight: 600;

    letter-spacing: 0.18em;
    text-transform: uppercase;

    color: var(--color-secondary);
  }

  .iban {
    margin-top: 0.5rem;

    overflow-wrap: anywhere;

    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    font-size: 0.95rem;

    line-height: 1.6;

    color: var(--color-heading);
  }

  .detail-block {
    margin-top: 1rem;
  }

  .account-holder {
    margin-top: 1rem;

    font-family: "DM Sans", sans-serif;

    font-size: 0.85rem;

    color: var(--color-text);
  }

  .account-holder span {
    font-weight: 600;

    color: var(--color-heading);
  }

  /* =========================================================
     COPY BUTTON
     ========================================================= */

  .copy-button {
    margin-top: 1.5rem;

    padding: 0.7rem 1.25rem;

    border: 1px solid var(--color-primary);

    border-radius: 9999px;

    background: transparent;

    font-family: "DM Sans", sans-serif;

    font-size: 0.68rem;
    font-weight: 600;

    letter-spacing: 0.2em;
    text-transform: uppercase;

    color: var(--color-primary);

    cursor: pointer;

    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .copy-button:hover {
    background: var(--color-primary);

    color: var(--color-surface);

    transform: translateY(-1px);
  }

  .copied-message {
    display: none;

    margin-top: 0.75rem;

    font-family: "DM Sans", sans-serif;

    font-size: 0.75rem;

    color: var(--color-secondary);
  }

  .copied-message.is-visible {
    display: block;
  }

  /* =========================================================
     QR
     ========================================================= */

  .qr-card {
    display: grid;

    grid-template-columns: 1fr auto;

    align-items: center;

    gap: 2rem;

    margin-top: 1rem;

    padding: 2rem;

    border: 1px solid var(--color-border-soft);

    border-radius: 1.5rem;

    background: var(--color-surface-soft);
  }

  .qr-intro {
    max-width: 32rem;

    margin-top: 0.75rem;

    font-family: "DM Sans", sans-serif;

    font-size: 0.85rem;

    line-height: 1.8;

    color: var(--color-text);
  }

  .qr-image-wrapper {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 9rem;
    height: 9rem;

    padding: 0.75rem;

    border: 1px solid var(--color-border);

    border-radius: 1rem;

    background: var(--color-surface);
  }

  .qr-image {
    width: 100%;
    height: 100%;

    object-fit: contain;
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 767px) {
    .honeymoon-section {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .honeymoon-section::before {
      top: -2.5rem;
      height: 2.5rem;
    }

    .honeymoon-section::after {
      bottom: -2.5rem;
      height: 2.5rem;
    }

    .honeymoon-heading {
      font-size: 2.25rem;
    }

    .wishlist-section,
    .gift-section {
      margin-top: 3.5rem;
    }

    .wishlist-grid,
    .accounts-grid {
      grid-template-columns: 1fr;
    }

    .experience-card {
      padding: 1.25rem;
    }

    .qr-card {
      grid-template-columns: 1fr;

      text-align: center;
    }

    .qr-intro {
      margin-left: auto;
      margin-right: auto;
    }

    .qr-image-wrapper {
      margin: 0 auto;
    }
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .experience-card,
    .copy-button {
      transition: none !important;
    }
  }
</style>

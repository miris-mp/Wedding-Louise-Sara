---
interface Question {
  question: string;
  answer: string;
}

interface Props {
  items: Question[];
}

const { items } = Astro.props;
---

<section class="bg-stone-50 py-24">
  <div class="mx-auto max-w-4xl px-6">
    <!-- Header -->
    <div class="mb-16 text-center">
      <p class="text-sm uppercase tracking-[0.35em] text-stone-500">
        Need to know
      </p>

      <h2 class="mt-4 font-serif text-5xl text-stone-800">
        Frequently Asked Questions
      </h2>

      <div class="mx-auto mt-6 h-px w-24 bg-stone-300"></div>
    </div>

    <!-- FAQ -->
    <div class="space-y-4">
      {
        items.map((item) => (
          <details class="group rounded-3xl border border-stone-200 bg-white p-6 transition open:shadow-md">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-xl text-stone-800">
              {item.question}

              <span class="flex h-8 w-8 items-center justify-center rounded-full border border-stone-300 text-stone-500 transition group-open:rotate-45">
                +
              </span>
            </summary>

            <p class="mt-5 max-w-3xl leading-7 text-stone-600">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

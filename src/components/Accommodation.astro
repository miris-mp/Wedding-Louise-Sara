---
import { Image } from "astro:assets";

interface Hotel {
  id?: string;
  name: string;
  location: string;
  description: string;
  distance?: string;
  url: string;
  image?: ImageMetadata;
}

interface Props {
  id?: string;
  hotels: Hotel[];
}

const { hotels } = Astro.props;
---

<section
  id="accommodation"
  class="accommodation-section relative py-14 md:py-18"
>
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- Header -->
    <div class="mb-10 text-center md:mb-12">
      <p
        class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-[#426b7a]"
      >
        For our guests
      </p>

      <h2 class="mt-3 font-serif text-4xl text-[#294653] md:text-5xl">
        Where To Stay
      </h2>

      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-[#e8c95a]"></div>

      <p
        class="mx-auto mt-5 max-w-2xl font-sans text-base leading-7 text-[#426b7a]"
      >
        We have selected some lovely places nearby where you can relax and enjoy
        your stay in Tuscany.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        hotels.map((hotel) => (
          <article class="group overflow-hidden rounded-[2rem] border border-white/70 bg-[#fffdf6] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            {hotel.image && (
              <div class="h-52 overflow-hidden">
                <Image
                  src={hotel.image}
                  alt={hotel.name}
                  class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                  inferSize={true}
                  width={100}
                  height={100}
                  loading="lazy"
                />
              </div>
            )}

            <div class="p-7">
              <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[#7e9b72]">
                {hotel.location}
              </p>

              <h3 class="mt-2 font-serif text-2xl text-[#294653] md:text-3xl">
                {hotel.name}
              </h3>

              <p class="mt-4 font-sans text-sm leading-6 text-[#426b7a]">
                {hotel.description}
              </p>

              {hotel.distance && (
                <p class="mt-4 font-sans text-xs text-[#426b7a]">
                  📍 {hotel.distance}
                </p>
              )}

              <a
                href={hotel.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex rounded-full bg-[#e8c95a] px-6 py-3 font-sans text-xs font-medium uppercase tracking-[0.2em] text-[#294653] shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#426b7a] hover:text-[#fffdf6] hover:shadow-md"
              >
                Discover
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .accommodation-section {
    position: relative;

    margin-top: 3.5rem;
    margin-bottom: 3.5rem;

    /* background: linear-gradient(180deg, #b9dce5 0%, #cce5e8 50%, #b9dce5 100%); */
  }

  /* Top diagonal */
  .accommodation-section::before {
    content: "";

    position: absolute;
    top: -3.5rem;
    left: 0;

    width: 100%;
    height: 3.5rem;

    background: #b9dce5;

    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  /* Bottom diagonal */
  .accommodation-section::after {
    content: "";

    position: absolute;
    bottom: -3.5rem;
    left: 0;

    width: 100%;
    height: 3.5rem;

    background: #b9dce5;

    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  @media (max-width: 767px) {
    .accommodation-section {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .accommodation-section::before {
      top: -2.5rem;
      height: 2.5rem;
    }

    .accommodation-section::after {
      bottom: -2.5rem;
      height: 2.5rem;
    }
  }
</style>

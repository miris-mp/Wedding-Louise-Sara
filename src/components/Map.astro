---
import "maplibre-gl/dist/maplibre-gl.css";

const pageLocale = Astro.currentLocale ?? "en";
---

<section class="memory-game relative py-14 md:py-20" data-locale={pageLocale}>
  <div class="memory-decoration memory-decoration-one"></div>
  <div class="memory-decoration memory-decoration-two"></div>

  <div class="relative z-10 mx-auto max-w-5xl px-6">
    <!-- Header -->
    <div class="mb-10 text-center md:mb-12">
      <p
        class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-(--color-sage)"
        data-i18n="eyebrow"
      >
        Our Story
      </p>

      <h2
        class="mt-3 font-serif text-4xl text-(--color-heading) md:text-5xl"
        data-i18n="heading"
      >
        Where Did It Happen?
      </h2>

      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-(--color-primary)">
      </div>

      <p
        id="instructions"
        class="mx-auto mt-5 max-w-xl font-sans text-base leading-7 text-(--color-text)"
      >
        Can you guess where this memory happened?
      </p>
    </div>

    <!-- City to guess + score -->
    <div
      class="memory-intro mx-auto mb-5 grid max-w-4xl grid-cols-1 items-center gap-3 sm:grid-cols-[minmax(0,1fr)_auto]"
    >
      <div
        class="memory-card min-w-0 rounded-2xl border border-(--color-border-soft) bg-(--color-surface) px-5 py-4 shadow-sm sm:px-6"
      >
        <p
          class="text-[0.65rem] font-medium uppercase tracking-[0.18em] text-(--color-sage)"
          data-i18n="findPlace"
        >
          Find this place
        </p>

        <h3
          id="city-name"
          class="mt-1 break-words font-serif text-xl leading-tight text-(--color-heading) sm:text-2xl"
        >
          Loading...
        </h3>

        <p id="city-country" class="mt-1 text-sm text-(--color-text)"></p>
      </div>

      <div class="grid grid-cols-2 gap-2 sm:flex sm:gap-2">
        <div
          class="score-card rounded-2xl border border-(--color-border-soft) bg-(--color-surface) px-4 py-3 text-center"
        >
          <p
            class="text-[0.65rem] font-medium uppercase tracking-wider text-(--color-sage)"
            data-i18n="round"
          >
            Round
          </p>

          <p
            id="round-counter"
            class="mt-1 font-serif text-lg leading-tight text-(--color-heading)"
          >
            1 / 5
          </p>
        </div>

        <div
          class="score-card rounded-2xl border border-(--color-border-soft) bg-(--color-surface) px-4 py-3 text-center"
        >
          <p
            class="text-[0.65rem] font-medium uppercase tracking-wider text-(--color-sage)"
            data-i18n="score"
          >
            Score
          </p>
          <p
            id="score"
            class="mt-1 font-serif text-lg leading-tight tabular-nums text-(--color-heading)"
          >
            0
          </p>
        </div>
      </div>
    </div>

    <!-- Map -->
    <div class="map-card relative mx-auto max-w-4xl">
      <div id="map" class="overflow-hidden rounded-4xl"></div>

      <div id="map-message" class="map-message">
        Click anywhere on the map to place your guess.
      </div>
    </div>

    <!-- Result / Story -->
    <section id="result" hidden class="result-card mx-auto mt-6 max-w-4xl">
      <div class="distance-badge">
        <span>You were</span>
        <strong id="distance"></strong>
        <span>away</span>
      </div>

      <div class="story-card">
        <div
          class="story-card-inner grid grid-cols-1 gap-5 text-left sm:p-6 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:items-center"
        >
          <!-- Photo on the left -->
          <div
            id="memory-image-wrapper"
            class="hidden min-h-0 overflow-hidden rounded-xl"
          >
            <img
              id="memory-image"
              src=""
              alt=""
              loading="lazy"
              class="memory-photo w-full object-cover"
            />
          </div>

          <!-- Story on the right -->
          <div class="min-w-0 px-1 py-2 sm:px-0">
            <p
              class="text-[0.65rem] font-medium uppercase tracking-[0.2em] text-(--color-sage)"
              data-i18n="memory"
            >
              The memory
            </p>

            <h2
              id="result-title"
              class="mt-2 font-serif text-xl leading-snug text-(--color-heading) sm:text-2xl"
            >
            </h2>

            <div class="mt-3 h-0.5 w-9 rounded-full bg-(--color-primary)"></div>

            <p
              id="result-story"
              class="mt-4 whitespace-pre-line text-sm leading-6 text-(--color-text) sm:text-[0.925rem] sm:leading-7"
            >
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- Actions -->
    <div class="game-actions mt-4 flex flex-wrap justify-center gap-2">
      <button id="next-button" type="button" hidden class="game-button">
        Next round
      </button>
    </div>
  </div>
</section>

<style>
  /* -----------------------------------------------
     Section
  ------------------------------------------------ */

  .memory-game {
    position: relative;
  }

  /* Small decorative shapes */

  .memory-decoration {
    position: absolute;
    z-index: 0;
    border: 1px solid color-mix(in srgb, var(--color-sage) 18%, transparent);
    border-radius: 999px;
    pointer-events: none;
  }

  .memory-decoration-one {
    top: 8rem;
    left: -5rem;
    width: 12rem;
    height: 12rem;
  }

  .memory-decoration-two {
    right: -6rem;
    bottom: 8rem;
    width: 14rem;
    height: 14rem;
  }

  /* -----------------------------------------------
     Map
  ------------------------------------------------ */

  #map {
    width: 100%;
    height: 520px;
    cursor: crosshair;
    background: var(--color-surface-soft);
  }

  .map-card {
    overflow: hidden;
    border-radius: 2rem;
    border: 4px solid var(--color-surface);
    box-shadow: 0 20px 45px rgba(41, 70, 83, 0.12);
  }

  /* -----------------------------------------------
     Floating map message
  ------------------------------------------------ */

  .map-message {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-heading) 88%, transparent);
    color: var(--color-surface);
    font-family: sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    pointer-events: none;
    backdrop-filter: blur(8px);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  /* -----------------------------------------------
     Buttons
  ------------------------------------------------ */

  .game-button {
    padding: 0.85rem 1.8rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-heading);
    font-family: sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 6px 15px rgba(41, 70, 83, 0.1);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease,
      background 300ms ease;
  }

  .game-button:hover:not(:disabled) {
    transform: translateY(-2px);
    background: var(--color-primary-hover);
    color: var(--color-surface);
    box-shadow: 0 10px 22px rgba(41, 70, 83, 0.16);
  }

  .game-button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    box-shadow: none;
  }

  /* -----------------------------------------------
     Result
  ------------------------------------------------ */

  .result-card {
    opacity: 0;
    transform: translateY(20px) scale(0.98);
    transition:
      opacity 600ms ease,
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .result-card.result-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .distance-badge {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
    color: var(--color-sage);
    font-family: sans-serif;
    font-size: 0.8rem;
  }

  .distance-badge strong {
    color: var(--color-heading);
    font-family: serif;
    font-size: 2rem;
    font-weight: 400;
  }

  /* -----------------------------------------------
     Story card
  ------------------------------------------------ */

  .story-card {
    position: relative;
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface);
    box-shadow: 0 14px 35px rgba(41, 70, 83, 0.09);
  }

  .story-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--color-primary);
  }

  .story-card-inner {
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .heart-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0 auto;
    border-radius: 999px;
    background: var(--color-wedding-soft);
    color: var(--color-sage);
  }

  /* -----------------------------------------------
     Memory card
  ------------------------------------------------ */

  .memory-card {
    transition:
      transform 400ms ease,
      box-shadow 400ms ease;
  }

  .memory-card:hover {
    transform: scale(1.01);
    box-shadow: 0 14px 30px rgba(41, 70, 83, 0.1);
  }

  #memory-image {
    transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .memory-card:hover #memory-image {
    transform: scale(1.035);
  }

  /* -----------------------------------------------
     Mobile
  ------------------------------------------------ */

  @media (max-width: 767px) {
    #map {
      height: 440px;
    }

    .map-card {
      border-width: 4px;
      border-radius: 1.5rem;
    }

    .map-message {
      bottom: 0.75rem;
      max-width: calc(100% - 2rem);
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .story-card-inner {
      padding: 1.75rem 1.25rem;
    }

    .game-actions {
      flex-wrap: wrap;
    }

    .memory-decoration-one {
      left: -8rem;
    }

    .memory-decoration-two {
      right: -9rem;
    }
  }

  /* -----------------------------------------------
     Reduced motion
  ------------------------------------------------ */

  @media (prefers-reduced-motion: reduce) {
    .result-card,
    .memory-card,
    #memory-image,
    .game-button {
      transition: none !important;
    }
  }
</style>

<script>
  import {
    Map,
    Marker,
    NavigationControl,
    LngLatBounds,
    setWorkerUrl,
  } from "maplibre-gl";

  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";

  import { cities, type City } from "../data/memories";
  import { getTranslations, type Locale } from "../i18n/utils";

  setWorkerUrl(workerUrl);
  const gameElement = document.querySelector<HTMLElement>(".memory-game");

  const locale = (gameElement?.dataset.locale ?? "en") as Locale;
  const t = getTranslations(locale);
  // --------------------------------------------------
  // DOM
  // --------------------------------------------------

  function applyTranslations() {
    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((element) => {
      const key = element.dataset.i18n as keyof typeof t.memories.ui;
      const value = t.memories.ui[key];

      if (typeof value === "string") {
        element.textContent = value;
      }
    });
  }

  applyTranslations();

  const cityNameElement =
    document.querySelector<HTMLHeadingElement>("#city-name");

  const cityCountryElement =
    document.querySelector<HTMLParagraphElement>("#city-country");

  const instructionsElement =
    document.querySelector<HTMLParagraphElement>("#instructions");

  const mapMessageElement =
    document.querySelector<HTMLDivElement>("#map-message");

  const nextButton = document.querySelector<HTMLButtonElement>("#next-button");

  const resultElement = document.querySelector<HTMLElement>("#result");

  const distanceElement = document.querySelector<HTMLElement>("#distance");

  const resultTitleElement =
    document.querySelector<HTMLHeadingElement>("#result-title");

  const resultStoryElement =
    document.querySelector<HTMLParagraphElement>("#result-story");

  const memoryImageWrapper = document.querySelector<HTMLDivElement>(
    "#memory-image-wrapper"
  );

  const memoryImage = document.querySelector<HTMLImageElement>("#memory-image");

  const roundCounterElement =
    document.querySelector<HTMLParagraphElement>("#round-counter");

  const scoreElement = document.querySelector<HTMLParagraphElement>("#score");
  // --------------------------------------------------
  // Game state
  // --------------------------------------------------

  // --------------------------------------------------
  // Game state
  // --------------------------------------------------

  const TOTAL_ROUNDS = 5;
  const MAX_POINTS = 1000;
  const ZERO_POINTS_DISTANCE = 5000;

  let roundCities: City[] = [];
  let roundIndex = 0;
  let totalScore = 0;

  let currentCity!: City;

  let playerGuess: {
    lng: number;
    lat: number;
  } | null = null;

  let guessMarker: Marker | null = null;
  let realMarker: Marker | null = null;

  let gameState: "guessing" | "revealed" = "guessing";

  // --------------------------------------------------
  // Randomly select five different memories
  // --------------------------------------------------

  function shuffleCities(): City[] {
    const shuffled = [...cities];

    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }

    return shuffled.slice(0, Math.min(TOTAL_ROUNDS, shuffled.length));
  }

  // --------------------------------------------------
  // Update score and progress
  // --------------------------------------------------

  function updateScoreUI() {
    scoreElement!.textContent = totalScore.toLocaleString();

    roundCounterElement!.textContent = `${roundIndex + 1} / ${roundCities.length}`;
  }

  // --------------------------------------------------
  // Load the current memory
  // --------------------------------------------------

  function selectCurrentCity() {
    currentCity = roundCities[roundIndex];

    const memory =
      t.memories.memories[currentCity.id as keyof typeof t.memories.memories];

    if (!memory) {
      console.error(`Missing translation for memory: ${currentCity.id}`);
      return;
    }

    cityNameElement!.textContent = memory.name;
    cityCountryElement!.textContent = memory.country;

    memoryImageWrapper!.classList.add("hidden");
    memoryImage!.removeAttribute("src");
    memoryImage!.alt = "";

    updateScoreUI();
  }

  // --------------------------------------------------
  // Distance
  // --------------------------------------------------

  function distanceInKm(
    lat1: number,
    lng1: number,
    lat2: number,
    lng2: number
  ) {
    const R = 6371;

    const dLat = ((lat2 - lat1) * Math.PI) / 180;

    const dLng = ((lng2 - lng1) * Math.PI) / 180;

    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos((lat1 * Math.PI) / 180) *
        Math.cos((lat2 * Math.PI) / 180) *
        Math.sin(dLng / 2) ** 2;

    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

    return R * c;
  }

  // --------------------------------------------------
  // Map
  // --------------------------------------------------

  const map = new Map({
    container: "map",

    style: {
      version: 8,

      projection: {
        type: "globe",
      },

      sources: {
        satellite: {
          type: "raster",

          tiles: [
            "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg",
          ],

          tileSize: 256,
        },
      },

      layers: [
        {
          id: "satellite",
          type: "raster",
          source: "satellite",
        },
      ],
    },

    center: [10, 45],

    zoom: 2,
  });

  map.addControl(new NavigationControl(), "bottom-right");

  // --------------------------------------------------
  // Map load
  // --------------------------------------------------

  map.on("load", () => {
    map.addSource("guess-line", {
      type: "geojson",

      data: {
        type: "Feature",

        geometry: {
          type: "LineString",
          coordinates: [],
        },

        properties: {},
      },
    });

    map.addLayer({
      id: "guess-line",

      type: "line",

      source: "guess-line",

      paint: {
        "line-width": 3,

        "line-opacity": 0.75,

        "line-dasharray": [2, 2],
      },
    });

    startNewGame();
  });

  // --------------------------------------------------
  // Map click = place guess
  // --------------------------------------------------

  map.on("click", (event) => {
    if (gameState === "revealed") {
      return;
    }

    const { lng, lat } = event.lngLat;

    playerGuess = {
      lng,
      lat,
    };

    guessMarker?.remove();

    guessMarker = new Marker({
      color: "#7e9b72",
    })
      .setLngLat([lng, lat])
      .addTo(map);

    revealAnswer();

    mapMessageElement!.textContent = "Happy with your guess?";

    instructionsElement!.textContent =
      "You can move your guess by clicking somewhere else.";
  });

  // --------------------------------------------------
  // Reveal answer
  // --------------------------------------------------

  function revealAnswer() {
    if (!playerGuess) return;

    gameState = "revealed";

    const actualLocation = currentCity.coordinates;

    // Real location marker
    realMarker = new Marker({
      color: "#e8c95a",
    })
      .setLngLat([actualLocation.lng, actualLocation.lat])
      .addTo(map);

    // Distance
    const distance = distanceInKm(
      playerGuess.lat,
      playerGuess.lng,
      actualLocation.lat,
      actualLocation.lng
    );

    const roundedDistance = Math.round(distance);

    // Line
    const lineSource = map.getSource("guess-line") as
      | import("maplibre-gl").GeoJSONSource
      | undefined;

    lineSource?.setData({
      type: "Feature",

      geometry: {
        type: "LineString",

        coordinates: [
          [playerGuess.lng, playerGuess.lat],

          [actualLocation.lng, actualLocation.lat],
        ],
      },

      properties: {},
    });

    // --------------------------------------------------
    // Calculate points
    // --------------------------------------------------

    const points = Math.round(
      MAX_POINTS * Math.max(0, 1 - roundedDistance / ZERO_POINTS_DISTANCE)
    );

    totalScore += points;

    // --------------------------------------------------
    // Reveal the memory image
    // --------------------------------------------------

    if (currentCity.image) {
      memoryImage!.src = currentCity.image.src;
      memoryImage!.alt = `${currentCity.name}, ${currentCity.country}`;
      memoryImageWrapper!.classList.remove("hidden");
    }

    // --------------------------------------------------
    // Result content
    // --------------------------------------------------

    distanceElement!.textContent = `${roundedDistance.toLocaleString()} km`;

    resultTitleElement!.textContent = `${currentCity.name}, ${currentCity.country}`;

    resultStoryElement!.textContent = currentCity.history;

    updateScoreUI();

    // --------------------------------------------------
    // Reveal the story
    // --------------------------------------------------

    resultElement!.hidden = false;

    requestAnimationFrame(() => {
      resultElement!.classList.add("result-visible");
    });

    // --------------------------------------------------
    // Buttons
    // --------------------------------------------------
    nextButton!.hidden = false;

    const isLastRound = roundIndex === roundCities.length - 1;

    nextButton!.textContent = isLastRound ? "Play again" : "Next round";

    // --------------------------------------------------
    // Instructions
    // --------------------------------------------------

    instructionsElement!.textContent = isLastRound
      ? `Round complete! You earned ${points.toLocaleString()} points.`
      : `You earned ${points.toLocaleString()} points this round!`;

    mapMessageElement!.textContent = `${roundedDistance.toLocaleString()} km away`;

    // --------------------------------------------------
    // Fit map around both locations
    // --------------------------------------------------

    const bounds = new LngLatBounds();

    bounds.extend([playerGuess.lng, playerGuess.lat]);
    bounds.extend([actualLocation.lng, actualLocation.lat]);

    map.fitBounds(bounds, {
      padding: 100,
      duration: 1500,
      maxZoom: 8,
    });
  }

  // --------------------------------------------------
  // Start a new game
  // --------------------------------------------------

  function startNewGame() {
    if (cities.length === 0) return;

    roundCities = shuffleCities();
    roundIndex = 0;
    totalScore = 0;

    resetRoundUI();
    selectCurrentCity();

    instructionsElement!.textContent = "Can you find this place on the map?";

    if (roundCities.length < TOTAL_ROUNDS) {
      instructionsElement!.textContent =
        `This game has ${roundCities.length} rounds because only ` +
        `${roundCities.length} memories are available.`;
    }
  }

  // --------------------------------------------------
  // Next round / play again
  // --------------------------------------------------

  nextButton?.addEventListener("click", () => {
    if (gameState !== "revealed") return;

    if (roundIndex >= roundCities.length - 1) {
      startNewGame();
      return;
    }

    roundIndex++;

    resetRoundUI();
    selectCurrentCity();

    instructionsElement!.textContent = "Can you find this place on the map?";
  });

  // --------------------------------------------------
  // Reset the current round's UI
  // --------------------------------------------------

  function resetRoundUI() {
    gameState = "guessing";
    playerGuess = null;

    guessMarker?.remove();
    realMarker?.remove();

    guessMarker = null;
    realMarker = null;

    // Clear the line between the guess and the real location.
    const lineSource = map.getSource("guess-line") as
      | import("maplibre-gl").GeoJSONSource
      | undefined;

    lineSource?.setData({
      type: "Feature",
      geometry: {
        type: "LineString",
        coordinates: [],
      },
      properties: {},
    });

    // Hide the previous result and image.
    resultElement!.hidden = true;
    resultElement!.classList.remove("result-visible");

    memoryImageWrapper!.classList.add("hidden");
    memoryImage!.removeAttribute("src");
    memoryImage!.alt = "";

    nextButton!.hidden = true;
    nextButton!.textContent = "Next round";

    mapMessageElement!.textContent =
      "Click anywhere on the map to place your guess.";

    // Reset the map view.
    map.flyTo({
      center: [10, 45],
      zoom: 2,
      duration: 1200,
    });
  }
</script>

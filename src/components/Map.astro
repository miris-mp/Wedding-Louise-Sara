---
import "maplibre-gl/dist/maplibre-gl.css";
---

<section class="memory-game relative py-14 md:py-20">
  <div class="memory-decoration memory-decoration-one"></div>
  <div class="memory-decoration memory-decoration-two"></div>

  <div class="relative z-10 mx-auto max-w-5xl px-6">
    ```
    <!-- Header -->
    <div class="mb-10 text-center md:mb-12">
      <p
        class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-[var(--color-sage)]"
      >
        Our Story
      </p>

      <h2
        class="mt-3 font-serif text-4xl text-[var(--color-heading)] md:text-5xl"
      >
        Where Did It Happen?
      </h2>

      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-[var(--color-primary)]">
      </div>

      <p
        id="instructions"
        class="mx-auto mt-5 max-w-xl font-sans text-base leading-7 text-[var(--color-text)]"
      >
        Can you guess where this memory happened?
      </p>
    </div>

    <!-- Memory introduction -->
    <div class="memory-intro mx-auto mb-8 max-w-3xl">
      <div
        class="memory-card overflow-hidden rounded-[2rem] border border-[var(--color-border-soft)] bg-[var(--color-surface)] shadow-md"
      >
        <!-- Optional memory image -->
        <div
          id="memory-image-wrapper"
          class="hidden h-56 overflow-hidden md:h-72"
        >
          <img
            id="memory-image"
            src=""
            alt=""
            class="h-full w-full object-cover"
          />
        </div>

        <div class="p-7 text-center md:p-9">
          <p
            class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[var(--color-sage)]"
          >
            The memory
          </p>

          <h3
            id="city-name"
            class="mt-2 font-serif text-3xl text-[var(--color-heading)] md:text-4xl"
          >
            Loading...
          </h3>

          <p
            id="city-country"
            class="mt-1 font-sans text-sm text-[var(--color-text)]"
          >
          </p>
        </div>
      </div>
    </div>

    <!-- Map -->
    <div class="map-card relative mx-auto max-w-4xl">
      <div id="map" class="overflow-hidden rounded-[2rem]"></div>

      <div id="map-message" class="map-message">
        Click anywhere on the map to place your guess.
      </div>
    </div>

    <!-- Actions -->
    <div class="game-actions mt-6 flex justify-center gap-3">
      <button id="guess-button" type="button" disabled class="game-button">
        Reveal the memory
      </button>

      <button id="next-button" type="button" hidden class="game-button">
        Next memory
      </button>
    </div>

    <!-- Result / Story -->
    <section id="result" hidden class="result-card mx-auto mt-10 max-w-3xl">
      <div class="distance-badge">
        <span>You were</span>
        <strong id="distance"></strong>
        <span>away</span>
      </div>

      <div class="story-card">
        <div class="story-card-inner">
          <p
            class="font-sans text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-sage)]"
          >
            The memory
          </p>

          <h2
            id="result-title"
            class="mt-3 font-serif text-3xl text-[var(--color-heading)] md:text-4xl"
          >
          </h2>

          <div
            class="mx-auto mt-4 h-1 w-10 rounded-full bg-[var(--color-primary)]"
          >
          </div>

          <p
            id="result-story"
            class="mt-6 font-sans text-base leading-8 text-[var(--color-text)]"
          >
          </p>

          <div class="mt-7 flex justify-center">
            <span class="heart-divider">
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path
                  d="M12 21s-7-4.35-9.5-9.15C.5 7.8 2.8 4 6.5 4c2.05 0 3.45 1.15 4.5 2.6C12.05 5.15 13.45 4 15.5 4 19.2 4 21.5 7.8 21.5 11.85 19 16.65 12 21 12 21Z"
                ></path>
              </svg>
            </span>
          </div>
        </div>
      </div>
    </section>
    ```
  </div>
</section>

<style>
  /* -----------------------------------------------
     Section
  ------------------------------------------------ */

  .memory-game {
    position: relative;
    overflow: hidden;
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
    background: var(--color-surface);
  }

  /*
   * Very subtle decorative color.
   * The page remains predominantly white.
   */

  .memory-game::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 42rem;
    height: 42rem;
    transform: translate(-50%, -55%);
    border-radius: 999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-wedding-soft) 55%, transparent) 0%,
      transparent 68%
    );
    pointer-events: none;
  }

  .memory-game::after {
    content: "";
    position: absolute;
    right: -10rem;
    bottom: -18rem;
    width: 30rem;
    height: 30rem;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 10%, transparent) 0%,
      transparent 68%
    );
    pointer-events: none;
  }

  /* Small decorative shapes */

  .memory-decoration {
    position: absolute;
    z-index: 0;
    border: 1px solid color-mix(in srgb, var(--color-sage) 18%, transparent);
    border-radius: 999px;
    pointer-events: none;
  }

  .memory-decoration-one {
    top: 8rem;
    left: -5rem;
    width: 12rem;
    height: 12rem;
  }

  .memory-decoration-two {
    right: -6rem;
    bottom: 8rem;
    width: 14rem;
    height: 14rem;
  }

  /* -----------------------------------------------
     Map
  ------------------------------------------------ */

  #map {
    width: 100%;
    height: 520px;
    cursor: crosshair;
    background: var(--color-surface-soft);
  }

  .map-card {
    overflow: hidden;
    border-radius: 2rem;
    border: 4px solid var(--color-surface);
    box-shadow: 0 20px 45px rgba(41, 70, 83, 0.12);
  }

  /* -----------------------------------------------
     Floating map message
  ------------------------------------------------ */

  .map-message {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-heading) 88%, transparent);
    color: var(--color-surface);
    font-family: sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    pointer-events: none;
    backdrop-filter: blur(8px);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  /* -----------------------------------------------
     Buttons
  ------------------------------------------------ */

  .game-button {
    padding: 0.85rem 1.8rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-heading);
    font-family: sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 6px 15px rgba(41, 70, 83, 0.1);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease,
      background 300ms ease;
  }

  .game-button:hover:not(:disabled) {
    transform: translateY(-2px);
    background: var(--color-primary-hover);
    color: var(--color-surface);
    box-shadow: 0 10px 22px rgba(41, 70, 83, 0.16);
  }

  .game-button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    box-shadow: none;
  }

  /* -----------------------------------------------
     Result
  ------------------------------------------------ */

  .result-card {
    opacity: 0;
    transform: translateY(20px) scale(0.98);
    transition:
      opacity 600ms ease,
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .result-card.result-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .distance-badge {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
    color: var(--color-sage);
    font-family: sans-serif;
    font-size: 0.8rem;
  }

  .distance-badge strong {
    color: var(--color-heading);
    font-family: serif;
    font-size: 2rem;
    font-weight: 400;
  }

  /* -----------------------------------------------
     Story card
  ------------------------------------------------ */

  .story-card {
    position: relative;
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface);
    box-shadow: 0 14px 35px rgba(41, 70, 83, 0.09);
  }

  .story-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--color-primary);
  }

  .story-card-inner {
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .heart-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0 auto;
    border-radius: 999px;
    background: var(--color-wedding-soft);
    color: var(--color-sage);
  }

  /* -----------------------------------------------
     Memory card
  ------------------------------------------------ */

  .memory-card {
    transition:
      transform 400ms ease,
      box-shadow 400ms ease;
  }

  .memory-card:hover {
    transform: scale(1.01);
    box-shadow: 0 14px 30px rgba(41, 70, 83, 0.1);
  }

  #memory-image {
    transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .memory-card:hover #memory-image {
    transform: scale(1.035);
  }

  /* -----------------------------------------------
     Mobile
  ------------------------------------------------ */

  @media (max-width: 767px) {
    .memory-game {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    #map {
      height: 440px;
    }

    .map-card {
      border-width: 4px;
      border-radius: 1.5rem;
    }

    .map-message {
      bottom: 0.75rem;
      max-width: calc(100% - 2rem);
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .story-card-inner {
      padding: 1.75rem 1.25rem;
    }

    .game-actions {
      flex-wrap: wrap;
    }

    .memory-decoration-one {
      left: -8rem;
    }

    .memory-decoration-two {
      right: -9rem;
    }
  }

  /* -----------------------------------------------
     Reduced motion
  ------------------------------------------------ */

  @media (prefers-reduced-motion: reduce) {
    .result-card,
    .memory-card,
    #memory-image,
    .game-button {
      transition: none !important;
    }
  }
</style>

<script>
  import {
    Map,
    Marker,
    NavigationControl,
    LngLatBounds,
    setWorkerUrl,
  } from "maplibre-gl";

  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";

  import { cities } from "../data/memories";

  setWorkerUrl(workerUrl);

  // --------------------------------------------------
  // Types
  // --------------------------------------------------

  type City = {
    id: string;
    name: string;
    country: string;

    coordinates: {
      lng: number;
      lat: number;
    };

    history: string;

    image?: string;
  };

  // --------------------------------------------------
  // DOM
  // --------------------------------------------------

  const cityNameElement =
    document.querySelector<HTMLHeadingElement>("#city-name");

  const cityCountryElement =
    document.querySelector<HTMLParagraphElement>("#city-country");

  const instructionsElement =
    document.querySelector<HTMLParagraphElement>("#instructions");

  const mapMessageElement =
    document.querySelector<HTMLDivElement>("#map-message");

  const guessButton =
    document.querySelector<HTMLButtonElement>("#guess-button");

  const nextButton = document.querySelector<HTMLButtonElement>("#next-button");

  const resultElement = document.querySelector<HTMLElement>("#result");

  const distanceElement = document.querySelector<HTMLElement>("#distance");

  const resultTitleElement =
    document.querySelector<HTMLHeadingElement>("#result-title");

  const resultStoryElement =
    document.querySelector<HTMLParagraphElement>("#result-story");

  const memoryImageWrapper = document.querySelector<HTMLDivElement>(
    "#memory-image-wrapper"
  );

  const memoryImage = document.querySelector<HTMLImageElement>("#memory-image");

  // --------------------------------------------------
  // Game state
  // --------------------------------------------------

  let currentCity: City;

  let playerGuess: {
    lng: number;
    lat: number;
  } | null = null;

  let guessMarker: Marker | null = null;

  let realMarker: Marker | null = null;

  let gameState: "guessing" | "revealed" = "guessing";

  let cityNum = 0;

  // --------------------------------------------------
  // Select next city
  // --------------------------------------------------

  function selectNextCity() {
    if (!cities.length) return;

    currentCity = cities[cityNum % cities.length] as City;

    cityNum++;

    updateCityUI();
  }

  // --------------------------------------------------
  // Update memory UI
  // --------------------------------------------------

  function updateCityUI() {
    if (!currentCity) return;

    cityNameElement!.textContent = currentCity.name;

    cityCountryElement!.textContent = currentCity.country;

    if (currentCity.image) {
      memoryImage!.src = currentCity.image;
      memoryImage!.alt = `${currentCity.name}, ${currentCity.country}`;

      memoryImageWrapper!.classList.remove("hidden");
    } else {
      memoryImageWrapper!.classList.add("hidden");
    }
  }

  // --------------------------------------------------
  // Distance
  // --------------------------------------------------

  function distanceInKm(
    lat1: number,
    lng1: number,
    lat2: number,
    lng2: number
  ) {
    const R = 6371;

    const dLat = ((lat2 - lat1) * Math.PI) / 180;

    const dLng = ((lng2 - lng1) * Math.PI) / 180;

    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos((lat1 * Math.PI) / 180) *
        Math.cos((lat2 * Math.PI) / 180) *
        Math.sin(dLng / 2) ** 2;

    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

    return R * c;
  }

  // --------------------------------------------------
  // Map
  // --------------------------------------------------

  const map = new Map({
    container: "map",

    style: {
      version: 8,

      projection: {
        type: "globe",
      },

      sources: {
        satellite: {
          type: "raster",

          tiles: [
            "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg",
          ],

          tileSize: 256,
        },
      },

      layers: [
        {
          id: "satellite",
          type: "raster",
          source: "satellite",
        },
      ],
    },

    center: [10, 45],

    zoom: 2,
  });

  map.addControl(new NavigationControl(), "bottom-right");

  // --------------------------------------------------
  // Map load
  // --------------------------------------------------

  map.on("load", () => {
    map.addSource("guess-line", {
      type: "geojson",

      data: {
        type: "Feature",

        geometry: {
          type: "LineString",
          coordinates: [],
        },

        properties: {},
      },
    });

    map.addLayer({
      id: "guess-line",

      type: "line",

      source: "guess-line",

      paint: {
        "line-width": 3,

        "line-opacity": 0.75,

        "line-dasharray": [2, 2],
      },
    });

    selectNextCity();
  });

  // --------------------------------------------------
  // Map click = place guess
  // --------------------------------------------------

  map.on("click", (event) => {
    if (gameState === "revealed") {
      return;
    }

    const { lng, lat } = event.lngLat;

    playerGuess = {
      lng,
      lat,
    };

    guessMarker?.remove();

    guessMarker = new Marker({
      color: "#7e9b72",
    })
      .setLngLat([lng, lat])
      .addTo(map);

    guessButton!.disabled = false;

    mapMessageElement!.textContent = "Happy with your guess?";

    instructionsElement!.textContent =
      "You can move your guess by clicking somewhere else.";
  });

  // --------------------------------------------------
  // Reveal button
  // --------------------------------------------------

  guessButton?.addEventListener("click", () => {
    if (!playerGuess) return;

    revealAnswer();
  });

  // --------------------------------------------------
  // Reveal answer
  // --------------------------------------------------

  function revealAnswer() {
    if (!playerGuess) return;

    gameState = "revealed";

    const actualLocation = currentCity.coordinates;

    // Real location marker
    realMarker = new Marker({
      color: "#e8c95a",
    })
      .setLngLat([actualLocation.lng, actualLocation.lat])
      .addTo(map);

    // Distance
    const distance = distanceInKm(
      playerGuess.lat,
      playerGuess.lng,
      actualLocation.lat,
      actualLocation.lng
    );

    const roundedDistance = Math.round(distance);

    // Line
    const lineSource = map.getSource("guess-line") as
      | import("maplibre-gl").GeoJSONSource
      | undefined;

    lineSource?.setData({
      type: "Feature",

      geometry: {
        type: "LineString",

        coordinates: [
          [playerGuess.lng, playerGuess.lat],

          [actualLocation.lng, actualLocation.lat],
        ],
      },

      properties: {},
    });

    // Result content
    distanceElement!.textContent = `${roundedDistance.toLocaleString()} km`;

    resultTitleElement!.textContent = `${currentCity.name}, ${currentCity.country}`;

    resultStoryElement!.textContent = currentCity.history;

    // Reveal story
    resultElement!.hidden = false;

    requestAnimationFrame(() => {
      resultElement!.classList.add("result-visible");
    });

    // Buttons
    guessButton!.hidden = true;

    nextButton!.hidden = false;

    // Instructions
    instructionsElement!.textContent =
      "And this is where the memory really happened.";

    mapMessageElement!.textContent = `${roundedDistance.toLocaleString()} km away`;

    // Fit map around both locations
    const bounds = new LngLatBounds();

    bounds.extend([playerGuess.lng, playerGuess.lat]);

    bounds.extend([actualLocation.lng, actualLocation.lat]);

    map.fitBounds(bounds, {
      padding: 100,

      duration: 1500,

      maxZoom: 8,
    });
  }

  // --------------------------------------------------
  // Next memory
  // --------------------------------------------------

  nextButton?.addEventListener("click", () => {
    resetGame();
  });

  // --------------------------------------------------
  // Reset
  // --------------------------------------------------

  function resetGame() {
    gameState = "guessing";

    playerGuess = null;

    guessMarker?.remove();

    realMarker?.remove();

    guessMarker = null;

    realMarker = null;

    const lineSource = map.getSource("guess-line") as
      | import("maplibre-gl").GeoJSONSource
      | undefined;

    lineSource?.setData({
      type: "Feature",

      geometry: {
        type: "LineString",
        coordinates: [],
      },

      properties: {},
    });

    resultElement!.hidden = true;

    resultElement!.classList.remove("result-visible");

    guessButton!.hidden = false;

    guessButton!.disabled = true;

    nextButton!.hidden = true;

    instructionsElement!.textContent =
      "Can you guess where this memory happened?";

    mapMessageElement!.textContent =
      "Click anywhere on the map to place your guess.";

    map.flyTo({
      center: [10, 45],

      zoom: 2,

      duration: 1200,
    });

    selectNextCity();
  }
</script>

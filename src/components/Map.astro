---
import "maplibre-gl/dist/maplibre-gl.css";
---

<section class="memory-game relative bg-[#e1f3e4] py-16 md:py-20">
  <div class="relative z-10 mx-auto max-w-5xl px-6">
    <!-- Header -->
    <div class="mb-10 text-center md:mb-12">
      <p
        class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-[#426b7a]"
      >
        Our Story
      </p>

      <h2 class="mt-3 font-serif text-4xl text-[#294653] md:text-5xl">
        Where Did It Happen?
      </h2>

      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-[#e8c95a]"></div>

      <p
        id="instructions"
        class="mx-auto mt-5 max-w-xl font-sans text-base leading-7 text-[#426b7a]"
      >
        Can you guess where this memory happened?
      </p>
    </div>

    <!-- Memory introduction -->
    <div class="memory-intro mx-auto mb-8 max-w-3xl">
      <div
        class="memory-card overflow-hidden rounded-[2rem] border border-white/70 bg-[#fffdf6] shadow-md"
      >
        <!-- Optional memory image -->
        <div
          id="memory-image-wrapper"
          class="hidden h-56 overflow-hidden md:h-72"
        >
          <img
            id="memory-image"
            src=""
            alt=""
            class="h-full w-full object-cover"
          />
        </div>

        <div class="p-7 text-center md:p-9">
          <p
            class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[#7e9b72]"
          >
            The memory
          </p>

          <h3
            id="city-name"
            class="mt-2 font-serif text-3xl text-[#294653] md:text-4xl"
          >
            Loading...
          </h3>

          <p id="city-country" class="mt-1 font-sans text-sm text-[#426b7a]">
          </p>
        </div>
      </div>
    </div>

    <!-- Map -->
    <div class="map-card relative mx-auto max-w-4xl">
      <div id="map" class="overflow-hidden rounded-[2rem] shadow-xl"></div>

      <!-- Map instruction -->
      <div id="map-message" class="map-message">
        Click anywhere on the map to place your guess.
      </div>
    </div>

    <!-- Actions -->
    <div class="game-actions mt-6 flex justify-center">
      <button id="guess-button" type="button" disabled class="game-button">
        Reveal the memory
      </button>

      <button id="next-button" type="button" hidden class="game-button">
        Next memory
      </button>
    </div>

    <!-- Result / Story -->
    <section id="result" hidden class="result-card mx-auto mt-10 max-w-3xl">
      <!-- Distance -->
      <div class="distance-badge">
        <span>You were</span>
        <strong id="distance"></strong>
        <span>away</span>
      </div>

      <!-- Story -->
      <div class="story-card">
        <div class="story-card-inner">
          <p
            class="font-sans text-xs font-medium uppercase tracking-[0.25em] text-[#7e9b72]"
          >
            The memory
          </p>

          <h2
            id="result-title"
            class="mt-3 font-serif text-3xl text-[#294653] md:text-4xl"
          >
          </h2>

          <div class="mx-auto mt-4 h-1 w-10 rounded-full bg-[#e8c95a]"></div>

          <p
            id="result-story"
            class="mt-6 font-sans text-base leading-8 text-[#426b7a]"
          >
          </p>

          <div class="mt-7 flex justify-center">
            <span class="heart-divider">
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path
                  d="M12 21s-7-4.35-9.5-9.15C.5 7.8 2.8 4 6.5 4c2.05 0 3.45 1.15 4.5 2.6C12.05 5.15 13.45 4 15.5 4 19.2 4 21.5 7.8 21.5 11.85 19 16.65 12 21 12 21Z"
                ></path>
              </svg>
            </span>
          </div>
        </div>
      </div>
    </section>
  </div>
</section>

<script>
  import {
    Map,
    Marker,
    NavigationControl,
    LngLatBounds,
    setWorkerUrl,
  } from "maplibre-gl";

  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";

  import { cities } from "../data/memories";

  setWorkerUrl(workerUrl);

  // --------------------------------------------------
  // Types
  // --------------------------------------------------

  type City = {
    id: string;
    name: string;
    country: string;

    coordinates: {
      lng: number;
      lat: number;
    };

    history: string;

    // Optional image for the memory
    image?: string;
  };

  // --------------------------------------------------
  // DOM
  // --------------------------------------------------

  const cityNameElement =
    document.querySelector<HTMLHeadingElement>("#city-name");

  const cityCountryElement =
    document.querySelector<HTMLParagraphElement>("#city-country");

  const instructionsElement =
    document.querySelector<HTMLParagraphElement>("#instructions");

  const mapMessageElement =
    document.querySelector<HTMLDivElement>("#map-message");

  const guessButton =
    document.querySelector<HTMLButtonElement>("#guess-button");

  const nextButton = document.querySelector<HTMLButtonElement>("#next-button");

  const resultElement = document.querySelector<HTMLElement>("#result");

  const distanceElement = document.querySelector<HTMLElement>("#distance");

  const resultTitleElement =
    document.querySelector<HTMLHeadingElement>("#result-title");

  const resultStoryElement =
    document.querySelector<HTMLParagraphElement>("#result-story");

  const memoryImageWrapper = document.querySelector<HTMLDivElement>(
    "#memory-image-wrapper"
  );

  const memoryImage = document.querySelector<HTMLImageElement>("#memory-image");

  // --------------------------------------------------
  // Game state
  // --------------------------------------------------

  let currentCity: City;

  let playerGuess: {
    lng: number;
    lat: number;
  } | null = null;

  let guessMarker: Marker | null = null;

  let realMarker: Marker | null = null;

  let gameState: "guessing" | "revealed" = "guessing";

  let cityNum = 0;

  // --------------------------------------------------
  // Select next city
  // --------------------------------------------------

  function selectNextCity() {
    if (!cities.length) return;

    currentCity = cities[cityNum % cities.length] as City;

    cityNum++;

    updateCityUI();
  }

  // --------------------------------------------------
  // Update memory UI
  // --------------------------------------------------

  function updateCityUI() {
    if (!currentCity) return;

    cityNameElement!.textContent = currentCity.name;

    cityCountryElement!.textContent = currentCity.country;

    // Optional image
    if (currentCity.image) {
      memoryImage!.src = currentCity.image;
      memoryImage!.alt = `${currentCity.name}, ${currentCity.country}`;

      memoryImageWrapper!.classList.remove("hidden");
    } else {
      memoryImageWrapper!.classList.add("hidden");
    }
  }

  // --------------------------------------------------
  // Distance
  // --------------------------------------------------

  function distanceInKm(
    lat1: number,
    lng1: number,
    lat2: number,
    lng2: number
  ) {
    const R = 6371;

    const dLat = ((lat2 - lat1) * Math.PI) / 180;

    const dLng = ((lng2 - lng1) * Math.PI) / 180;

    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos((lat1 * Math.PI) / 180) *
        Math.cos((lat2 * Math.PI) / 180) *
        Math.sin(dLng / 2) ** 2;

    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

    return R * c;
  }

  // --------------------------------------------------
  // Map
  // --------------------------------------------------

  const map = new Map({
    container: "map",

    style: {
      version: 8,

      projection: {
        type: "globe",
      },

      sources: {
        satellite: {
          type: "raster",

          tiles: [
            "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg",
          ],

          tileSize: 256,
        },
      },

      layers: [
        {
          id: "satellite",
          type: "raster",
          source: "satellite",
        },
      ],
    },

    center: [10, 45],

    zoom: 2,
  });

  map.addControl(new NavigationControl(), "bottom-right");

  // --------------------------------------------------
  // Map load
  // --------------------------------------------------

  map.on("load", () => {
    map.addSource("guess-line", {
      type: "geojson",

      data: {
        type: "Feature",
        geometry: {
          type: "LineString",
          coordinates: [],
        },
        properties: {},
      },
    });

    map.addLayer({
      id: "guess-line",

      type: "line",

      source: "guess-line",

      paint: {
        "line-width": 3,

        "line-opacity": 0.75,

        "line-dasharray": [2, 2],
      },
    });

    selectNextCity();
  });

  // --------------------------------------------------
  // Map click = place guess
  // --------------------------------------------------

  map.on("click", (event) => {
    if (gameState === "revealed") {
      return;
    }

    const { lng, lat } = event.lngLat;

    playerGuess = {
      lng,
      lat,
    };

    // Remove previous marker
    guessMarker?.remove();

    // Add new guess marker
    guessMarker = new Marker({
      color: "#426b7a",
    })
      .setLngLat([lng, lat])
      .addTo(map);

    // Enable reveal
    guessButton!.disabled = false;

    mapMessageElement!.textContent = "Happy with your guess?";

    instructionsElement!.textContent =
      "You can move your guess by clicking somewhere else.";
  });

  // --------------------------------------------------
  // Reveal button
  // --------------------------------------------------

  guessButton?.addEventListener("click", () => {
    if (!playerGuess) return;

    revealAnswer();
  });

  // --------------------------------------------------
  // Reveal answer
  // --------------------------------------------------

  function revealAnswer() {
    if (!playerGuess) return;

    gameState = "revealed";

    const actualLocation = currentCity.coordinates;

    // ----------------------------------------------
    // Real location marker
    // ----------------------------------------------

    realMarker = new Marker({
      color: "#d69e2e",
    })
      .setLngLat([actualLocation.lng, actualLocation.lat])
      .addTo(map);

    // ----------------------------------------------
    // Distance
    // ----------------------------------------------

    const distance = distanceInKm(
      playerGuess.lat,
      playerGuess.lng,
      actualLocation.lat,
      actualLocation.lng
    );

    const roundedDistance = Math.round(distance);

    // ----------------------------------------------
    // Line
    // ----------------------------------------------

    const lineSource = map.getSource("guess-line") as
      | import("maplibre-gl").GeoJSONSource
      | undefined;

    lineSource?.setData({
      type: "Feature",

      geometry: {
        type: "LineString",

        coordinates: [
          [playerGuess.lng, playerGuess.lat],

          [actualLocation.lng, actualLocation.lat],
        ],
      },

      properties: {},
    });

    // ----------------------------------------------
    // Result content
    // ----------------------------------------------

    distanceElement!.textContent = `${roundedDistance.toLocaleString()} km`;

    resultTitleElement!.textContent = `${currentCity.name}, ${currentCity.country}`;

    resultStoryElement!.textContent = currentCity.history;

    // ----------------------------------------------
    // Reveal story
    // ----------------------------------------------

    resultElement!.hidden = false;

    requestAnimationFrame(() => {
      resultElement!.classList.add("result-visible");
    });

    // ----------------------------------------------
    // Buttons
    // ----------------------------------------------

    guessButton!.hidden = true;

    nextButton!.hidden = false;

    // ----------------------------------------------
    // Instructions
    // ----------------------------------------------

    instructionsElement!.textContent =
      "And this is where the memory really happened.";

    mapMessageElement!.textContent = `${roundedDistance.toLocaleString()} km away`;

    // ----------------------------------------------
    // Fit map around both locations
    // ----------------------------------------------

    const bounds = new LngLatBounds();

    bounds.extend([playerGuess.lng, playerGuess.lat]);

    bounds.extend([actualLocation.lng, actualLocation.lat]);

    map.fitBounds(bounds, {
      padding: 100,

      duration: 1500,

      maxZoom: 8,
    });
  }

  // --------------------------------------------------
  // Next memory
  // --------------------------------------------------

  nextButton?.addEventListener("click", () => {
    resetGame();
  });

  // --------------------------------------------------
  // Reset
  // --------------------------------------------------

  function resetGame() {
    gameState = "guessing";

    playerGuess = null;

    guessMarker?.remove();

    realMarker?.remove();

    guessMarker = null;

    realMarker = null;

    // Clear line
    const lineSource = map.getSource("guess-line") as
      | import("maplibre-gl").GeoJSONSource
      | undefined;

    lineSource?.setData({
      type: "Feature",

      geometry: {
        type: "LineString",

        coordinates: [],
      },

      properties: {},
    });

    // Hide result
    resultElement!.hidden = true;

    resultElement!.classList.remove("result-visible");

    // Buttons
    guessButton!.hidden = false;

    guessButton!.disabled = true;

    nextButton!.hidden = true;

    // Text
    instructionsElement!.textContent =
      "Can you guess where this memory happened?";

    mapMessageElement!.textContent =
      "Click anywhere on the map to place your guess.";

    // Reset map
    map.flyTo({
      center: [10, 45],

      zoom: 2,

      duration: 1200,
    });

    // Next memory
    selectNextCity();
  }
</script>

<style>
  /* -----------------------------------------------
     Section
  ------------------------------------------------ */

  .memory-game {
    position: relative;

    margin-top: 4rem;
    margin-bottom: 4rem;
  }

  .memory-game::before {
    content: "";

    position: absolute;

    top: -4rem;

    left: 0;

    width: 100%;

    height: 4rem;

    background: #fff;

    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  .memory-game::after {
    content: "";

    position: absolute;

    bottom: -4rem;

    left: 0;

    width: 100%;

    height: 4rem;

    background: #fff;

    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  /* -----------------------------------------------
     Map
  ------------------------------------------------ */

  #map {
    width: 100%;

    height: 520px;

    cursor: crosshair;

    background: #dce8e5;
  }

  .map-card {
    overflow: hidden;

    border-radius: 2rem;

    border: 6px solid rgba(255, 253, 246, 0.75);

    box-shadow: 0 20px 45px rgba(41, 70, 83, 0.12);
  }

  /* -----------------------------------------------
     Floating map message
  ------------------------------------------------ */

  .map-message {
    position: absolute;

    left: 50%;

    bottom: 1.25rem;

    transform: translateX(-50%);

    padding: 0.65rem 1.1rem;

    border-radius: 999px;

    background: rgba(41, 70, 83, 0.88);

    color: #fffdf6;

    font-family: sans-serif;

    font-size: 0.75rem;

    letter-spacing: 0.04em;

    white-space: nowrap;

    pointer-events: none;

    backdrop-filter: blur(8px);

    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  /* -----------------------------------------------
     Buttons
  ------------------------------------------------ */

  .game-button {
    padding: 0.85rem 1.8rem;

    border: 0;

    border-radius: 999px;

    background: #e8c95a;

    color: #294653;

    font-family: sans-serif;

    font-size: 0.7rem;

    font-weight: 600;

    letter-spacing: 0.16em;

    text-transform: uppercase;

    cursor: pointer;

    box-shadow: 0 6px 15px rgba(41, 70, 83, 0.1);

    transition:
      transform 300ms ease,
      box-shadow 300ms ease,
      background 300ms ease;
  }

  .game-button:hover:not(:disabled) {
    transform: translateY(-2px) scale(1.02);

    background: #426b7a;

    color: #fffdf6;

    box-shadow: 0 10px 22px rgba(41, 70, 83, 0.16);
  }

  .game-button:disabled {
    opacity: 0.45;

    cursor: not-allowed;

    box-shadow: none;
  }

  /* -----------------------------------------------
     Result
  ------------------------------------------------ */

  .result-card {
    opacity: 0;

    transform: translateY(20px) scale(0.98);

    transition:
      opacity 600ms ease,
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .result-card.result-visible {
    opacity: 1;

    transform: translateY(0) scale(1);
  }

  /* -----------------------------------------------
     Distance
  ------------------------------------------------ */

  .distance-badge {
    display: flex;

    align-items: baseline;

    justify-content: center;

    gap: 0.45rem;

    margin-bottom: 1.25rem;

    color: #426b7a;

    font-family: sans-serif;

    font-size: 0.8rem;
  }

  .distance-badge strong {
    color: #294653;

    font-family: serif;

    font-size: 2rem;

    font-weight: 400;
  }

  /* -----------------------------------------------
     Story card
  ------------------------------------------------ */

  .story-card {
    position: relative;

    overflow: hidden;

    border-radius: 2rem;

    background: #fffdf6;

    border: 1px solid rgba(185, 220, 229, 0.55);

    box-shadow: 0 14px 35px rgba(41, 70, 83, 0.09);
  }

  .story-card::before {
    content: "";

    position: absolute;

    top: 0;

    left: 0;

    width: 100%;

    height: 5px;

    background: #e8c95a;
  }

  .story-card-inner {
    padding: 2rem 1.5rem;

    text-align: center;
  }

  .heart-divider {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 2.5rem;

    height: 2.5rem;

    margin: 0 auto;

    border-radius: 999px;

    background: #e1f3e4;

    color: #7e9b72;
  }

  /* -----------------------------------------------
     Memory card
  ------------------------------------------------ */

  .memory-card {
    transition:
      transform 400ms ease,
      box-shadow 400ms ease;
  }

  .memory-card:hover {
    transform: scale(1.01);

    box-shadow: 0 14px 30px rgba(41, 70, 83, 0.1);
  }

  #memory-image {
    transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .memory-card:hover #memory-image {
    transform: scale(1.035);
  }

  /* -----------------------------------------------
     Mobile
  ------------------------------------------------ */

  @media (max-width: 767px) {
    .memory-game {
      margin-top: 2.5rem;

      margin-bottom: 2.5rem;
    }

    .memory-game::before {
      top: -2.5rem;

      height: 2.5rem;
    }

    .memory-game::after {
      bottom: -2.5rem;

      height: 2.5rem;
    }

    #map {
      height: 440px;
    }

    .map-card {
      border-width: 4px;

      border-radius: 1.5rem;
    }

    .map-message {
      bottom: 0.75rem;

      max-width: calc(100% - 2rem);

      overflow: hidden;

      text-overflow: ellipsis;
    }

    .story-card-inner {
      padding: 1.75rem 1.25rem;
    }
  }

  /* -----------------------------------------------
     Reduced motion
  ------------------------------------------------ */

  @media (prefers-reduced-motion: reduce) {
    .result-card,
    .memory-card,
    #memory-image,
    .game-button {
      transition: none !important;
    }
  }
</style>

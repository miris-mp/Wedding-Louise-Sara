---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section id="rsvp" class="rsvp-section relative bg-[#fffdf6] py-16 md:py-24">
    <div class="relative z-10 mx-auto max-w-3xl px-6">
      <!-- Heading -->
      <div class="mb-10 text-center md:mb-12">
        <p
          class="font-sans text-xs font-medium uppercase tracking-[0.35em] text-[#426b7a]"
        >
          We'd love to hear from you
        </p>

        <h2
          class="mt-3 font-serif text-4xl leading-tight text-[#294653] md:text-5xl"
        >
          Will You Join Us?
        </h2>

        <div class="mx-auto mt-5 flex items-center justify-center gap-3">
          <span class="h-px w-10 bg-[#b9dce5]"></span>
          <span class="text-[#e8c95a]">✦</span>
          <span class="h-px w-10 bg-[#b9dce5]"></span>
        </div>

        <p
          class="mx-auto mt-5 max-w-md font-sans text-base leading-relaxed text-[#426b7a]"
        >
          Your presence would mean the world to us. Please let us know if you'll
          be celebrating with us.
        </p>
      </div>

      <!-- Form Card -->
      <form
        id="rsvp-form"
        class="relative overflow-hidden rounded-[2rem] border border-[#b9dce5]/60 bg-white/90 p-6 shadow-[0_20px_60px_rgba(41,70,83,0.08)] backdrop-blur md:p-10"
      >
        <!-- Decorative corners -->
        <div
          class="pointer-events-none absolute -right-12 -top-12 h-32 w-32 rounded-full border border-[#e8c95a]/30"
        >
        </div>

        <div
          class="pointer-events-none absolute -bottom-16 -left-16 h-36 w-36 rounded-full border border-[#b9dce5]/40"
        >
        </div>

        <div class="relative space-y-5">
          <!-- Guest 1 / Main guest -->
          <div>
            <label
              for="rsvp-name"
              class="mb-2 block font-sans text-xs font-medium uppercase tracking-[0.18em] text-[#426b7a]"
            >
              Your name
            </label>

            <input
              id="rsvp-name"
              name="name"
              type="text"
              placeholder="Your name"
              required
              class="w-full rounded-xl border border-[#b9dce5]/70 bg-[#f7fbfa] px-5 py-3.5 font-sans text-[#294653] outline-none transition placeholder:text-[#426b7a]/45 focus:border-[#426b7a] focus:bg-white focus:ring-4 focus:ring-[#b9dce5]/20"
            />
          </div>
          <!-- Dietary requirements for main guest -->
          <div id="dietary-field">
            <label
              for="rsvp-dietary"
              class="mb-2 block font-sans text-xs font-medium uppercase tracking-[0.18em] text-[#426b7a]"
            >
              Dietary requirements
            </label>

            <textarea
              id="rsvp-dietary"
              name="dietary"
              placeholder="Please let us know about any dietary requirements..."
              rows="3"
              class="w-full resize-none rounded-xl border border-[#b9dce5]/70 bg-[#f7fbfa] px-5 py-3.5 font-sans text-[#294653] outline-none transition placeholder:text-[#426b7a]/45 focus:border-[#426b7a] focus:bg-white focus:ring-4 focus:ring-[#b9dce5]/20"
            ></textarea>
          </div>
          <!-- Email -->
          <div>
            <label
              for="rsvp-email"
              class="mb-2 block font-sans text-xs font-medium uppercase tracking-[0.18em] text-[#426b7a]"
            >
              Email address
            </label>

            <input
              id="rsvp-email"
              name="email"
              type="email"
              placeholder="you@example.com"
              required
              class="w-full rounded-xl border border-[#b9dce5]/70 bg-[#f7fbfa] px-5 py-3.5 font-sans text-[#294653] outline-none transition placeholder:text-[#426b7a]/45 focus:border-[#426b7a] focus:bg-white focus:ring-4 focus:ring-[#b9dce5]/20"
            />
          </div>

          <!-- Attendance -->
          <fieldset>
            <legend
              class="mb-3 block font-sans text-xs font-medium uppercase tracking-[0.18em] text-[#426b7a]"
            >
              Will you be joining us?
            </legend>

            <div class="grid gap-3 sm:grid-cols-2">
              <!-- Yes -->
              <label class="group cursor-pointer">
                <input
                  type="radio"
                  name="attendance"
                  value="Yes"
                  required
                  class="peer sr-only"
                />

                <div
                  class="rounded-2xl border border-[#b9dce5]/70 bg-[#f7fbfa] p-5 text-center transition-all duration-300 group-hover:-translate-y-0.5 group-hover:border-[#426b7a]/50 group-hover:bg-white peer-checked:border-[#426b7a] peer-checked:bg-[#edf7f5] peer-checked:shadow-sm"
                >
                  <div
                    class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-[#e8c95a]/20 text-xl transition-transform duration-300 group-hover:scale-105 peer-checked:scale-110"
                  >
                    ♡
                  </div>

                  <p class="font-serif text-xl text-[#294653]">
                    Joyfully accepting
                  </p>

                  <p class="mt-1 font-sans text-xs text-[#426b7a]/70">
                    We’ll see you there!
                  </p>
                </div>
              </label>

              <!-- No -->
              <label class="group cursor-pointer">
                <input
                  type="radio"
                  name="attendance"
                  value="No"
                  required
                  class="peer sr-only"
                />

                <div
                  class="rounded-2xl border border-[#b9dce5]/70 bg-[#f7fbfa] p-5 text-center transition-all duration-300 group-hover:-translate-y-0.5 group-hover:border-[#426b7a]/50 group-hover:bg-white peer-checked:border-[#426b7a] peer-checked:bg-[#edf7f5] peer-checked:shadow-sm"
                >
                  <div
                    class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-[#b9dce5]/25 text-xl transition-transform duration-300 group-hover:scale-105 peer-checked:scale-110"
                  >
                    ♧
                  </div>

                  <p class="font-serif text-xl text-[#294653]">
                    Sadly declining
                  </p>

                  <p class="mt-1 font-sans text-xs text-[#426b7a]/70">
                    We’ll miss you!
                  </p>
                </div>
              </label>
            </div>
          </fieldset>

          <!-- Number of guests -->
          <div id="guests-field">
            <label
              for="rsvp-guests"
              class="mb-2 block font-sans text-xs font-medium uppercase tracking-[0.18em] text-[#426b7a]"
            >
              Number of guests
            </label>

            <select
              id="rsvp-guests"
              name="guests"
              required
              class="w-fit rounded-xl border border-[#b9dce5]/70 bg-[#f7fbfa] px-5 py-3.5 font-sans text-[#294653] outline-none transition focus:border-[#426b7a] focus:bg-white focus:ring-4 focus:ring-[#b9dce5]/20"
            >
              <option value="1">1</option>
              <option value="2">2</option>
            </select>
          </div>

          <!-- Guest 2 -->
          <div
            id="guest-2-field"
            class="hidden rounded-2xl border border-[#b9dce5]/50 bg-[#f7fbfa]/60 p-5"
          >
            <label
              for="rsvp-guest-2-name"
              class="mb-2 block font-sans text-xs font-medium uppercase tracking-[0.18em] text-[#426b7a]"
            >
              Second guest's name
            </label>

            <input
              id="rsvp-guest-2-name"
              name="guest_2_name"
              type="text"
              placeholder="Second guest's name"
              class="w-full rounded-xl border border-[#b9dce5]/70 bg-white px-5 py-3.5 font-sans text-[#294653] outline-none transition placeholder:text-[#426b7a]/45 focus:border-[#426b7a] focus:ring-4 focus:ring-[#b9dce5]/20"
            />

            <label
              for="rsvp-guest-2-dietary"
              class="mb-2 mt-5 block font-sans text-xs font-medium uppercase tracking-[0.18em] text-[#426b7a]"
            >
              Second guest's dietary requirements
            </label>

            <textarea
              id="rsvp-guest-2-dietary"
              name="guest_2_dietary"
              placeholder="Please let us know about any dietary requirements..."
              rows="3"
              class="w-full resize-none rounded-xl border border-[#b9dce5]/70 bg-white px-5 py-3.5 font-sans text-[#294653] outline-none transition placeholder:text-[#426b7a]/45 focus:border-[#426b7a] focus:ring-4 focus:ring-[#b9dce5]/20"
            ></textarea>
          </div>

          <!-- Playlist -->
          <div id="playlist-field">
            <label
              for="rsvp-song"
              class="mb-2 block font-sans text-xs font-medium uppercase tracking-[0.18em] text-[#426b7a]"
            >
              A song that gets you on the dance floor 🎶
            </label>

            <input
              id="rsvp-song"
              name="song"
              type="text"
              list="song-suggestions"
              placeholder="Song title or artist..."
              autocomplete="off"
              class="w-full rounded-xl border border-[#b9dce5]/70 bg-[#f7fbfa] px-5 py-3.5 font-sans text-[#294653] outline-none transition placeholder:text-[#426b7a]/45 focus:border-[#426b7a] focus:bg-white focus:ring-4 focus:ring-[#b9dce5]/20"
            />

            <datalist id="song-suggestions">
              <option value="Dancing Queen — ABBA"></option>
              <option value="September — Earth, Wind & Fire"></option>
              <option value="I Wanna Dance with Somebody — Whitney Houston"
              ></option>
              <option value="Mr. Brightside — The Killers"></option>
              <option value="Don't Stop Me Now — Queen"></option>
              <option value="Dancing in the Moonlight — Toploader"></option>
              <option value="Mamma Mia — ABBA"></option>
              <option value="Levitating — Dua Lipa"></option>
              <option value="Music Sounds Better with You — Stardust"></option>
              <option value="Finally — CeCe Peniston"></option>
            </datalist>

            <p class="mt-2 font-sans text-xs text-[#426b7a]/60">
              Give us your ultimate dance-floor anthem.
            </p>
          </div>

          <!-- Message -->
          <div>
            <label
              for="rsvp-message"
              class="mb-2 block font-sans text-xs font-medium uppercase tracking-[0.18em] text-[#426b7a]"
            >
              A little note for the couple
            </label>

            <textarea
              id="rsvp-message"
              name="message"
              placeholder="Leave us a little message..."
              rows="3"
              class="w-full resize-none rounded-xl border border-[#b9dce5]/70 bg-[#f7fbfa] px-5 py-3.5 font-sans text-[#294653] outline-none transition placeholder:text-[#426b7a]/45 focus:border-[#426b7a] focus:bg-white focus:ring-4 focus:ring-[#b9dce5]/20"
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="mt-2 w-full rounded-full bg-[#e8c95a] py-4 font-sans text-xs font-medium uppercase tracking-[0.25em] text-[#294653] shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#426b7a] hover:text-[#fffdf6] hover:shadow-lg disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send My RSVP
          </button>

          <!-- Success -->
          <div
            id="success"
            class="hidden rounded-[1.75rem] border border-[#b9dce5]/50 bg-[#f7fbfa] px-6 py-9 text-center"
          >
            <div id="success-yes" class="hidden">
              <p class="font-serif text-3xl text-[#294653]">
                We’ll see you there!
              </p>

              <p
                class="mx-auto mt-3 max-w-md font-sans text-base leading-relaxed text-[#426b7a]"
              >
                Thank you for celebrating this special day with us. We can’t
                wait to share it with you.
              </p>
            </div>

            <div id="success-no" class="hidden">
              <p class="font-serif text-3xl text-[#294653]">We’ll miss you!</p>

              <p
                class="mx-auto mt-3 max-w-md font-sans text-base leading-relaxed text-[#426b7a]"
              >
                Thank you so much for letting us know. We’re sorry you won’t be
                able to join us, but we’ll be thinking of you.
              </p>
            </div>
          </div>

          <!-- Error -->
          <div
            id="error"
            class="hidden rounded-2xl border border-red-100 bg-red-50 p-5 text-center font-sans text-sm text-red-700"
          >
            Something went wrong. Please try again.
          </div>
        </div>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector("#rsvp-form") as HTMLFormElement;

  const button = form?.querySelector(
    'button[type="submit"]'
  ) as HTMLButtonElement;

  const success = document.querySelector("#success");
  const successYes = document.querySelector("#success-yes");
  const successNo = document.querySelector("#success-no");
  const errorMessage = document.querySelector("#error");

  const guestsField = document.querySelector("#guests-field");
  const dietaryField = document.querySelector("#dietary-field");
  const playlistField = document.querySelector("#playlist-field");

  const guestsInput = document.querySelector(
    'select[name="guests"]'
  ) as HTMLSelectElement;

  const guest2Field = document.querySelector("#guest-2-field");
  const guest2Name = document.querySelector(
    "#rsvp-guest-2-name"
  ) as HTMLInputElement;

  const GOOGLE_SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbwLPHMzx-2JmQCMVgKCjA4yXK8tPrYBfhbA7azzbLULoRvjhwTXTKfK94UYar2X-PE/exec";

  /*
   * Show / hide fields depending on attendance.
   */
  form?.querySelectorAll('input[name="attendance"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      const selected = (
        form.querySelector(
          'input[name="attendance"]:checked'
        ) as HTMLInputElement
      )?.value;

      if (selected === "No") {
        guestsField?.classList.add("hidden");
        dietaryField?.classList.add("hidden");
        guest2Field?.classList.add("hidden");
        playlistField?.classList.add("hidden");

        if (guestsInput) {
          guestsInput.required = false;
          guestsInput.value = "1";
        }

        if (guest2Name) {
          guest2Name.required = false;
          guest2Name.value = "";
        }
      } else {
        guestsField?.classList.remove("hidden");
        dietaryField?.classList.remove("hidden");
        playlistField?.classList.remove("hidden");

        if (guestsInput) {
          guestsInput.required = true;
        }

        updateGuestFields();
      }
    });
  });

  /*
   * Show Guest 2 when two guests are selected.
   */
  function updateGuestFields() {
    if (!guestsInput) return;

    const numberOfGuests = Number(guestsInput.value);

    if (numberOfGuests === 2) {
      guest2Field?.classList.remove("hidden");

      if (guest2Name) {
        guest2Name.required = true;
      }
    } else {
      guest2Field?.classList.add("hidden");

      if (guest2Name) {
        guest2Name.required = false;
        guest2Name.value = "";
      }
    }
  }

  guestsInput?.addEventListener("change", updateGuestFields);

  /*
   * Submit RSVP.
   */
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!button) return;

    errorMessage?.classList.add("hidden");

    button.disabled = true;
    button.textContent = "Sending...";

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    console.log("Sending RSVP:", data);

    try {
      const response = await fetch(GOOGLE_SCRIPT_URL, {
        method: "POST",
        headers: {
          "Content-Type": "text/plain;charset=utf-8",
        },
        body: JSON.stringify(data),
      });

      if (!response.ok) {
        throw new Error(`Request failed with status ${response.status}`);
      }

      const result = await response.json();

      console.log("Google response:", result);

      if (!result.success) {
        throw new Error(result.error || "Google Apps Script returned an error");
      }

      const attendance = data.attendance;

      if (attendance === "Yes") {
        successYes?.classList.remove("hidden");
        successNo?.classList.add("hidden");
      } else {
        successNo?.classList.remove("hidden");
        successYes?.classList.add("hidden");
      }

      /*
       * Hide form controls.
       */
      form
        .querySelectorAll("input, textarea, select, button, fieldset, label")
        .forEach((element) => {
          (element as HTMLElement).style.display = "none";
        });

      success?.classList.remove("hidden");
    } catch (error) {
      console.error("RSVP error:", error);

      button.disabled = false;
      button.textContent = "Send My RSVP";

      errorMessage?.classList.remove("hidden");
    }
  });
</script>

<style>
  .rsvp-section {
    position: relative;
    background: #fffdf6;
    margin-top: 5rem;
    margin-bottom: 5rem;
  }

  .rsvp-section::before {
    content: "";
    position: absolute;
    top: -5rem;
    left: 0;
    width: 100%;
    height: 5rem;
    background: #fffdf6;
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  .rsvp-section::after {
    content: "";
    position: absolute;
    bottom: -5rem;
    left: 0;
    width: 100%;
    height: 5rem;
    background: #fffdf6;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
</style>

---
import "../styles/global.css";

const returnTo = Astro.url.searchParams.get("returnTo") ?? "/";
const isItalian = returnTo === "/it" || returnTo.startsWith("/it/");
const hasError = Astro.url.searchParams.get("error") === "1";
---

<!doctype html>
<html lang={isItalian ? "it" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>
      {isItalian ? "Accesso ospiti" : "Guest access"} | Louise & Sara
    </title>
  </head>

  <body>
    <main class="access-page">
      <section class="access-card">
        <p class="eyebrow">Louise & Sara</p>

        <h1>
          {isItalian ? "Un giorno speciale" : "A special day"}
        </h1>

        <p class="intro">
          {
            isItalian
              ? "Questo sito è riservato ai nostri invitati. Inserisci il codice di accesso per continuare."
              : "Our wedding website is reserved for invited guests. Enter your access code to continue."
          }
        </p>

        {
          hasError && (
            <p class="error-message" role="alert">
              {isItalian
                ? "Codice non valido. Riprova."
                : "That code wasn't correct. Please try again."}
            </p>
          )
        }

        <form method="POST" action="/api/access">
          <input type="hidden" name="returnTo" value={returnTo} />

          <label for="code">
            {isItalian ? "Codice di accesso" : "Access code"}
          </label>

          <input
            id="code"
            name="code"
            type="password"
            autocomplete="current-password"
            required
            autofocus
            placeholder={isItalian ? "Inserisci il codice" : "Enter your code"}
          />

          <button type="submit">
            {isItalian ? "Entra" : "Enter"}
          </button>
        </form>

        <p class="footer-note">
          {
            isItalian
              ? "Con affetto, Louise & Sara"
              : "With love, Louise & Sara"
          }
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  .access-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: var(--color-page-bg, #f2e6da);
  }

  .access-card {
    width: min(100%, 440px);
    padding: clamp(1.75rem, 6vw, 3rem);
    text-align: center;
    background: var(--color-surface, #fffdf9);
    border: 1px solid var(--color-border-soft, #d8dfd5);
    border-radius: 24px;
    box-shadow: 0 16px 50px rgb(47 74 63 / 8%);
  }

  .eyebrow {
    color: var(--color-primary, #cf8981);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.8rem 0;
    color: var(--color-heading, #2f4a3f);
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(2rem, 7vw, 2.8rem);
    font-weight: 400;
  }

  .intro {
    margin: 0 0 1.75rem;
    color: var(--color-text, #496158);
    line-height: 1.7;
  }

  form {
    display: grid;
    gap: 0.75rem;
    text-align: left;
  }

  label {
    color: var(--color-heading, #2f4a3f);
    font-size: 0.9rem;
    font-weight: 600;
  }

  input {
    width: 100%;
    min-height: 48px;
    padding: 0.8rem 1rem;
    color: var(--color-text, #496158);
    background: white;
    border: 1px solid var(--color-border-soft, #d8dfd5);
    border-radius: 10px;
    font: inherit;
  }

  input:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--color-primary-hover, #bd746c);
    outline-offset: 3px;
  }

  button {
    min-height: 48px;
    margin-top: 0.35rem;
    padding: 0.8rem 1rem;
    color: white;
    background: var(--color-forest, #2f4a3f);
    border: 0;
    border-radius: 10px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  button:hover {
    opacity: 0.88;
  }

  .error-message {
    padding: 0.75rem;
    color: #8a342d;
    background: #f9e8e5;
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .footer-note {
    margin: 1.75rem 0 0;
    color: var(--color-text-muted, #6f8078);
    font-family: var(--font-display, Georgia, serif);
    font-style: italic;
  }
</style>

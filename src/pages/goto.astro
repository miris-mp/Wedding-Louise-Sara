---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section id="goto" class="tuscany-guide relative py-14 md:py-18">
    <div class="relative z-10 mx-auto max-w-4xl px-6">
      <!-- Intro -->
      <div class="mb-9 text-center md:mb-10">
        <p
          class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-[#426b7a]"
        >
          While you're here
        </p>

        <h2 class="mt-3 font-serif text-4xl text-[#294653] md:text-5xl">
          Explore Puglia
        </h2>

        <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-[#e8c95a]"></div>

        <p
          class="mx-auto mt-5 max-w-2xl font-sans text-base leading-7 text-[#426b7a]"
        >
          If you have a little extra time before or after the wedding, here are
          a few ideas for making the most of your stay in Italy.
        </p>
      </div>

      <!-- Expandable guide -->
      <details
        class="guide-card group overflow-hidden rounded-[2rem] border border-[#b9dce5]/50 bg-white/80 shadow-md backdrop-blur transition-all duration-500 ease-out hover:scale-[1.01] hover:shadow-xl"
      >
        <!-- Trigger -->
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 md:p-8"
        >
          <div class="flex items-center gap-4">
            <!-- Icon -->
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#e8c95a]/30 text-[#294653]"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                class="h-5 w-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path>
                <circle cx="12" cy="9" r="2.3"></circle>
              </svg>
            </div>

            <div>
              <p
                class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[#7e9b72]"
              >
                Our little guide
              </p>

              <h3 class="mt-1 font-serif text-2xl text-[#294653] md:text-3xl">
                Make a little trip of it
              </h3>
            </div>
          </div>

          <!-- Animated plus -->
          <span
            class="guide-plus flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#b9dce5]/70 text-[#426b7a] transition-all duration-500 ease-out group-open:rotate-45 group-open:bg-[#e8c95a] group-open:text-[#294653]"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              class="h-5 w-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 5v14M5 12h14"></path>
            </svg>
          </span>
        </summary>

        <!-- Animated content -->
        <div class="guide-content">
          <div
            class="border-t border-[#b9dce5]/40 px-6 pb-8 pt-7 md:px-8 md:pb-10"
          >
            <div class="space-y-8">
              <!-- Getting around -->
              <div>
                <div class="mb-3 flex items-center gap-3">
                  <span class="text-[#7e9b72]">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      class="h-5 w-5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 17h14M7 17l1.5-6h7L17 17M9 11l1-3h4l1 3M8 20h.01M16 20h.01"
                      ></path>
                    </svg>
                  </span>

                  <h4 class="font-serif text-xl text-[#294653]">
                    Getting around
                  </h4>
                </div>

                <p class="font-sans text-sm leading-7 text-[#426b7a]">
                  A car is the easiest way to explore the countryside and small
                  villages. Take your time, follow the scenic roads, and don't
                  worry too much about the itinerary.
                </p>
              </div>

              <!-- Places -->
              <div>
                <div class="mb-4 flex items-center gap-3">
                  <span class="text-[#7e9b72]">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      class="h-5 w-5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4 21h16M5 21V9l7-5 7 5v12M9 21v-6h6v6"></path>
                    </svg>
                  </span>

                  <h4 class="font-serif text-xl text-[#294653]">
                    Places worth visiting
                  </h4>
                </div>

                <div class="grid gap-4 md:grid-cols-3">
                  <!-- Florence -->
                  <div
                    class="rounded-2xl border border-[#b9dce5]/40 bg-[#fffdf6] p-5 transition-all duration-300 hover:-translate-y-1 hover:scale-[1.02] hover:shadow-md"
                  >
                    <p
                      class="font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-[#7e9b72]"
                    >
                      For a day
                    </p>

                    <h5 class="mt-2 font-serif text-xl text-[#294653]">
                      Florence
                    </h5>

                    <p class="mt-3 font-sans text-sm leading-6 text-[#426b7a]">
                      Art, architecture, beautiful streets and plenty of places
                      to stop for an aperitivo.
                    </p>

                    <a
                      href="https://www.google.com/maps/search/?api=1&query=Florence%2C%20Italy"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-4 inline-flex font-sans text-xs font-medium uppercase tracking-[0.15em] text-[#426b7a] transition-colors hover:text-[#7e9b72]"
                    >
                      View on map →
                    </a>
                  </div>

                  <!-- Lucca -->
                  <div
                    class="rounded-2xl border border-[#b9dce5]/40 bg-[#fffdf6] p-5 transition-all duration-300 hover:-translate-y-1 hover:scale-[1.02] hover:shadow-md"
                  >
                    <p
                      class="font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-[#7e9b72]"
                    >
                      Slow afternoon
                    </p>

                    <h5 class="mt-2 font-serif text-xl text-[#294653]">
                      Lucca
                    </h5>

                    <p class="mt-3 font-sans text-sm leading-6 text-[#426b7a]">
                      Wander the old town, cycle the city walls and enjoy a long
                      Italian lunch.
                    </p>

                    <a
                      href="https://www.google.com/maps/search/?api=1&query=Lucca%2C%20Italy"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-4 inline-flex font-sans text-xs font-medium uppercase tracking-[0.15em] text-[#426b7a] transition-colors hover:text-[#7e9b72]"
                    >
                      View on map →
                    </a>
                  </div>

                  <!-- Chianti -->
                  <div
                    class="rounded-2xl border border-[#b9dce5]/40 bg-[#fffdf6] p-5 transition-all duration-300 hover:-translate-y-1 hover:scale-[1.02] hover:shadow-md"
                  >
                    <p
                      class="font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-[#7e9b72]"
                    >
                      Take it slow
                    </p>

                    <h5 class="mt-2 font-serif text-xl text-[#294653]">
                      Chianti
                    </h5>

                    <p class="mt-3 font-sans text-sm leading-6 text-[#426b7a]">
                      Vineyards, rolling hills, little villages and scenic roads
                      made for getting pleasantly lost.
                    </p>

                    <a
                      href="https://www.google.com/maps/search/?api=1&query=Chianti%2C%20Tuscany%2C%20Italy"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-4 inline-flex font-sans text-xs font-medium uppercase tracking-[0.15em] text-[#426b7a] transition-colors hover:text-[#7e9b72]"
                    >
                      View on map →
                    </a>
                  </div>
                </div>
              </div>

              <!-- Food -->
              <div>
                <div class="mb-3 flex items-center gap-3">
                  <span class="text-[#7e9b72]">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      class="h-5 w-5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7 3v8M4 3v5a3 3 0 0 0 6 0V3M7 11v10M17 3v18M17 3c2 1.5 3 3.5 3 6v1h-3"
                      ></path>
                    </svg>
                  </span>

                  <h4 class="font-serif text-xl text-[#294653]">Eat well</h4>
                </div>

                <p class="font-sans text-sm leading-7 text-[#426b7a]">
                  Don't plan every meal. Pick a little trattoria, order
                  something you've never tried, and stay for dessert. Tuscany is
                  best enjoyed slowly.
                </p>
              </div>

              <!-- One day -->
              <div class="rounded-[1.5rem] bg-[#e8c95a]/20 p-6 md:p-7">
                <p
                  class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-[#7e9b72]"
                >
                  If we had one day
                </p>

                <h4 class="mt-2 font-serif text-2xl text-[#294653]">
                  Coffee → village → lunch → wine → sunset
                </h4>

                <p class="mt-3 font-sans text-sm leading-7 text-[#426b7a]">
                  Start with a slow breakfast, choose one beautiful village to
                  explore, have a long lunch, stop somewhere for a glass of
                  wine, and finish the day watching the sun go down over the
                  hills.
                </p>
              </div>

              <!-- Closing -->
              <p
                class="pt-1 text-center font-serif text-xl italic text-[#426b7a]"
              >
                “The best memories are usually the unplanned ones.”
              </p>
            </div>
          </div>
        </div>
      </details>
    </div>
  </section>
</Layout>
<style>
  .tuscany-guide {
    position: relative;
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }

  .tuscany-guide::before {
    content: "";
    position: absolute;
    top: -3.5rem;
    left: 0;
    width: 100%;
    height: 3.5rem;
    background: #fff;
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  .tuscany-guide::after {
    content: "";
    position: absolute;
    bottom: -3.5rem;
    left: 0;
    width: 100%;
    height: 3.5rem;
    background: #fff;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  /*
   * Smooth accordion animation
   *
   * <details> itself cannot reliably animate height with
   * max-height, so we animate the inner content using
   * grid-template-rows.
   */
  .guide-content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 300ms ease;
  }

  .guide-content > div {
    min-height: 0;
    overflow: hidden;
  }

  .guide-card[open] .guide-content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /*
   * Small movement when opening.
   */
  .guide-content > div {
    transform: translateY(-8px);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .guide-card[open] .guide-content > div {
    transform: translateY(0);
  }

  /*
   * Prevent the browser's default marker.
   */
  summary::-webkit-details-marker {
    display: none;
  }

  summary::marker {
    display: none;
  }

  /*
   * Subtle hover scale.
   * Kept deliberately small so it still feels elegant.
   */
  .guide-card {
    transform-origin: center;
    will-change: transform, box-shadow;
  }

  /*
   * Smooth interaction for the trigger.
   */
  .guide-card summary {
    transition:
      background-color 300ms ease,
      padding 300ms ease;
  }

  .guide-card summary:hover {
    background: rgba(255, 253, 246, 0.65);
  }

  /*
   * Slightly soften the hover effect on touch devices.
   */
  @media (hover: none) {
    .guide-card:hover {
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .tuscany-guide {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .tuscany-guide::before {
      top: -2.5rem;
      height: 2.5rem;
    }

    .tuscany-guide::after {
      bottom: -2.5rem;
      height: 2.5rem;
    }
  }

  /*
   * Respect users who prefer reduced motion.
   */
  @media (prefers-reduced-motion: reduce) {
    .guide-card,
    .guide-content,
    .guide-content > div,
    .guide-plus,
    .guide-card summary {
      transition: none !important;
    }
  }
</style>
